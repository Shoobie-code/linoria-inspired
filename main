local Y = "1.3.1";
local function R()
	local Y = rawget(_G, "UILib");
	if type(Y) ~= "table" and type(getgenv) == "function" then
		local R, f = pcall(getgenv);
		if R and type(f) == "table" then
			Y = rawget(f, "UILib");
		end;
	end;
	if type(Y) == "table" then
		return Y;
	end;
	return nil;
end;
do
	local f = R();
	if f and not f._dead then
		if f.Version == Y and not rawget(_G, "UI_RELOAD") then
			if rawget(_G, "UILib") ~= f then
				pcall(function()
					_G.UILib = f;
				end);
			end;
			return f;
		end;
		if type(f.Unload) == "function" then
			pcall(f.Unload, f);
		end;
	end;
end;
local f = Drawing;
