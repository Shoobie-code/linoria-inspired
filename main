function Nn.AddKeybind(R, Y)
	local f = Vf(R, "keybind", Y, Pn);
	Y = f.o;
	f.mode = Y.mode or "toggle";
	f.state = f.mode == "always";
	f.clicks = {};
	if Y.onClick then
		f.clicks[1] = Y.onClick;
	end;
	f.n = { hover = nf(f, "Square", rf.hover), label = nf(f, "Text", rf.text), key = nf(f, "Text", rf.text) };
	if f._badge then
		f.n.badge = nf(f, "Text", rf.text);
	end;
	f:_apply(m(Y.default or Y.key) or false);
	ff._binds[#ff._binds + 1] = f;
	return f;
end;
function Nn.AddLabel(R, Y)
	local f = Vf(R, "label", Y, gn);
	Y = f.o;
	f.color = Y.color;
	f.dim = Y.dim;
	f.wrap = Y.wrap ~= false;
	f.n = { lines = {} };
	f.addons = {};
	f:_split();
	return f;
end;
function Nn.AddDivider(Y)
	local R = Vf(Y, "divider", {}, On);
	R.n = { line = nf(R, "Square", rf.ctl) };
	return R;
end;
function Nn.SetVisible(R, Y)
	Y = Y and true or false;
	if Y ~= R.visible then
		R.visible = Y;
		if not Y then
			R:_hide();
		end;
		R.win._dirty = true;
	end;
	return R;
end;
function Nn.SetCollapsed(R, Y)
	Y = Y and true or false;
	if Y == R.collapsed or not R.collapsible then
		return R;
	end;
	R.collapsed = Y;
	if Y then
		for Y = 1, #R.widgets, 1 do
			R.widgets[Y]:hideNodes();
		end;
	end;
	local f = R.win;
	f._dirty = true;
	ff._hoverDirty = true;
	if f.configFile then
		f._saveAt = T() + .75;
	end;
	return R;
end;
function Nn.IsCollapsed(Y)
	return Y.collapsed;
end;
function Nn.Toggle(Y)
	return Y:SetCollapsed(not Y.collapsed);
end;
function Nn._key(Y)
	return Y.tab.name .. ("/" .. Y.title);
end;
function Nn.SetTitle(R, Y)
	R.title = tostring(Y or "");
	R.win._dirty = true;
	return R;
end;
function Nn._hide(Y)
	Wf(Y.nodes);
	for R = 1, #Y.widgets, 1 do
		Y.widgets[R]:hideNodes();
	end;
end;
function Nn._paintBox(j, Y, R, f, A, k, M)
	j._box = {
			Y,
			R,
			f,
			A,
			k,
			M,
		};
	local u, P = j.n, ff.C;
	local q, g = o(R + 1, k), Q(A, M);
	if g - q >= 1 then
		af(u.edge, Y, q, f, g - q, P.border);
		local R = (A <= M) and A - 1 or g;
		af(u.fill, Y + 1, q, f - 2, R - q, P.group);
	else
		Xf(u.edge);
		Xf(u.fill);
	end;
	local O = R - jf.half;
	if R >= k and R < M then
		if j.title ~= "" and (O >= k and O + jf.th <= M) then
			local A = ff._hoverGroup == j;
			af(u.dash, Y, R, jf.dash, 1, P.header);
			local k = Y + jf.titleX;
			local M = j.collapsed and "[+]" or (A and "[-]" or nil);
			local o = Of(j.title, (f - 24) - ((M and qf(M) + 8 or 0)));
			Ff(u.title, o, k, O, A and P.accent or P.text);
			af(u.patch, k - 3, O, qf(o) + 6, (R - O) + 1, P.group);
			local Q = (k + qf(o)) + 4;
			local q = Y + f;
			if M then
				local k = ((Y + f) - jf.dash) - qf(M);
				Ff(u.mark, M, k, O, A and P.accent or P.textDim);
				af(u.mpatch, k - 3, O, qf(M) + 6, (R - O) + 1, P.group);
				q = k - 4;
			else
				Xf(u.mark);
				Xf(u.mpatch);
			end;
			af(u.line, Q, R, q - Q, 1, P.header);
		else
			Xf(u.dash);
			Xf(u.title);
			Xf(u.patch);
			Xf(u.mark);
			Xf(u.mpatch);
			af(u.line, Y, R, f, 1, P.header);
		end;
	else
		Xf(u.dash);
		Xf(u.title);
		Xf(u.patch);
		Xf(u.mark);
		Xf(u.mpatch);
		Xf(u.line);
	end;
end;
function Nn._repaintHeader(Y)
	local R = Y._box;
	if R and (Y.win.alive and Y.win._laidOut) then
		Y:_paintBox(R[1], R[2], R[3], R[4], R[5], R[6]);
	end;
end;
local Sn = {};
Sn.__index = Sn;
function Sn.AddGroup(A, Y, R, f)
	local k = A.win;
	f = type(f) == "table" and f or {};
	local o = R;
	if o == "left" or o == nil then
		o = 1;
	elseif o == "right" then
		o = k.columns;
	elseif o == "middle" or o == "center" then
		o = Q(2, k.columns);
	end;
	o = U(M(tonumber(o) or 1), 1, k.columns);
	local j = setmetatable({
			win = k,
			tab = A,
			col = o,
			title = tostring(Y or ""),
			widgets = {},
			nodes = {},
			visible = true,
			collapsed = f.collapsed and true or false,
			collapsible = f.collapsible ~= false,
		}, Nn);
	local function u(Y, R, f)
		local A = cf(k.nodes, Y, R, f);
		j.nodes[#j.nodes + 1] = A;
		return A;
	end;
	j.n = {
			edge = u("Square", rf.gEdge, true),
			fill = u("Square", rf.gFill, true),
			dash = u("Square", rf.gHead),
			line = u("Square", rf.gHead),
			title = u("Text", rf.text),
			patch = u("Square", rf.gHead, true),
			mark = u("Text", rf.text),
			mpatch = u("Square", rf.gHead, true),
		};
	local P = A.cols[o];
	P[#P + 1] = j;
	A.groups[#A.groups + 1] = j;
	k._dirty = true;
	return j;
end;
function Sn.AddLeftGroup(R, Y)
	return R:AddGroup(Y, 1);
end;
function Sn.AddRightGroup(R, Y)
	return R:AddGroup(Y, R.win.columns);
end;
Sn.AddLeftGroupbox = Sn.AddLeftGroup;
Sn.AddRightGroupbox = Sn.AddRightGroup;
Sn.AddGroupbox = Sn.AddGroup;
Sn.AddSection = Sn.AddGroup;
function Sn.Select(Y)
	Y.win:SelectTab(Y);
	return Y;
end;
function Sn.SetVisible(R, Y)
	R.visible = Y and true or false;
	R.win._dirty = true;
	return R;
end;
function Sn._hide(Y)
	for R = 1, #Y.groups, 1 do
		Y.groups[R]:_hide();
	end;
end;
local rn = {};
rn.__index = rn;
local Un = 32;
local function cn(Y)
	return ((((tostring(Y or "")):gsub("[^%w%-_ ]", "")):gsub("^%s+", "")):gsub("%s+$", ""));
end;
function rn._setZ(R, Y)
	local f = R.nodes;
	if f.zoff == Y then
		return;
	end;
	f.zoff = Y;
	for R = 1, #f, 1 do
		local A = f[R];
		if not A.dead then
			A.d.ZIndex = A.z + Y;
		end;
	end;
end;
local function Xn()
	for Y, R in ipairs(ff.Windows) do
		R:_setZ(((Y - 1)) * Uf);
	end;
end;
function ff.CreateWindow(Y, R)
	local f = Af(Y, R);
	f = type(f) == "table" and f or { title = f };
	local A = tostring(f.id or f.title or "ui");
	for Y = #ff.Windows, 1, -1 do
		if ff.Windows[Y].id == A then
			ff.Windows[Y]:Destroy();
		end;
	end;
	local k = f.size or {};
	local o, j = Jf();
	local u = ff.TextSize / 13;
	local P = M(((tonumber(k[1] or k.X or f.width) or 500)) * u + .5);
	local q = M(((tonumber(k[2] or k.Y or f.height) or 560)) * u + .5);
	local g = setmetatable({
			id = A,
			title = tostring(f.title or "ui"),
			subtitle = f.subtitle and tostring(f.subtitle) or nil,
			x = tonumber(f.x) or M(((o - P)) / 2),
			y = tonumber(f.y) or M(((j - q)) / 2),
			w = P,
			h = q,
			minW = Q(M(260 * u), P),
			minH = Q(M(160 * u), q),
			columns = U(M(tonumber(f.columns) or 2), 1, 3),
			resizable = f.resizable ~= false,
			showTabs = f.showTabs,
			visible = f.visible ~= false,
			fadeV = 0,
			alive = true,
			tabs = {},
			nodes = {},
			widgets = {},
			depWidgets = {},
			flags = {},
			flagOrder = {},
			cols = {},
			hits = {},
			ghits = {},
			sbars = {},
			toggleKey = m(f.toggleKey or f.key or "RSHIFT"),
			folder = f.folder or ("UI/" .. ((cn(A) ~= "" and cn(A) or "window"))),
			autoloadEnabled = f.autoload ~= false,
			configFile = f.config,
			inputGuard = f.inputGuard,
			captureInput = f.captureInput,
			onUnload = f.onUnload,
			_dirty = true,
		}, rn);
	g.Flags = g.flags;
	g.nodes.zoff = #ff.Windows * Uf;
	local O = {};
	local function N(Y, R, f)
		return cf(g.nodes, Y, R, f);
	end;
	O.frame = N("Square", rf.frame, true);
	O.frameIn = N("Square", rf.frameIn, true);
	O.bg = N("Square", rf.bg, true);
	O.titleBg = N("Square", rf.chrome, true);
	O.tabBg = N("Square", rf.chrome, true);
	O.sep1 = N("Square", rf.chrome + 1);
	O.sep2 = N("Square", rf.chrome + 1);
	O.title = N("Text", rf.chromeText);
	O.subtitle = N("Text", rf.chromeText);
	O.underline = N("Square", rf.chromeText);
	O.bar = {};
	for Y = 1, Un, 1 do
		O.bar[Y] = N("Square", rf.chromeText);
	end;
	O.grip = { N("Square", rf.sthumb), N("Square", rf.sthumb), N("Square", rf.sthumb) };
	for Y = 1, g.columns, 1 do
		g.sbars[Y] = {
				track = N("Square", rf.sbar),
				thumb = N("Square", rf.sthumb),
				upBg = N("Square", rf.sbar),
				up = {
					N("Square", rf.sthumb),
					N("Square", rf.sthumb),
					N("Square", rf.sthumb),
					N("Square", rf.sthumb),
				},
				dnBg = N("Square", rf.sbar),
				dn = {
					N("Square", rf.sthumb),
					N("Square", rf.sthumb),
					N("Square", rf.sthumb),
					N("Square", rf.sthumb),
				},
			};
		g.hits[Y] = { n = 0 };
		g.ghits[Y] = { n = 0 };
		g.cols[Y] = {
				x = 0,
				y = 0,
				w = 0,
				h = 0,
			};
	end;
	g.ch = O;
	ff.Windows[#ff.Windows + 1] = g;
	ff:_wake();
	return g;
end;
function rn.AddTab(R, Y)
	local f = setmetatable({
			win = R,
			name = tostring(Y or ("tab " .. (#R.tabs + 1))),
			cols = {},
			scroll = {},
			target = {},
			content = {},
			maxScroll = {},
			groups = {},
			visible = true,
		}, Sn);
	for Y = 1, R.columns, 1 do
		f.cols[Y] = {};
		f.scroll[Y], f.target[Y], f.content[Y], f.maxScroll[Y] = 0, 0, 0, 0;
	end;
	f.nText = cf(R.nodes, "Text", rf.chromeText);
	R.tabs[#R.tabs + 1] = f;
	if not R.active then
		R.active = f;
	end;
	R._dirty = true;
	return f;
end;
function rn._visibleTabs(Y)
	local R = {};
	for Y, f in ipairs(Y.tabs) do
		if f.visible then
			R[#R + 1] = f;
		end;
	end;
	return R;
end;
function rn._activeTab(Y)
	local R = Y.active;
	if R and R.visible then
		return R;
	end;
	for Y, R in ipairs(Y.tabs) do
		if R.visible then
			return R;
		end;
	end;
	return nil;
end;
function rn.SelectTab(R, Y)
	local f = Y;
	if type(Y) == "number" then
		f = R.tabs[Y];
	elseif type(Y) == "string" then
		for R, A in ipairs(R.tabs) do
			if A.name == Y then
				f = A;
			end;
		end;
	end;
	if f and f ~= R.active then
		R.active = f;
		if ff._drop and ff._drop.win == R then
			df();
		end;
		R._dirty = true;
		ff._hoverDirty = true;
		if R.configFile then
			R._saveAt = T() + .75;
		end;
	end;
	return R;
end;
function rn._registerFlag(R, Y)
	R.flags[Y.flag] = Y;
	R.flagOrder[#R.flagOrder + 1] = Y;
	ff.Flags[Y.flag] = Y;
end;
function rn.GetValue(R, Y)
	local f = R.flags[Y];
	if f then
		return f:Get();
	end;
	return nil;
end;
function rn.SetValue(f, Y, R)
	local A = f.flags[Y];
	if A then
		A:Set(R);
	end;
	return f;
end;
function rn._changed(R, Y)
	if bf.visible then
		bf.dirty = true;
	end;
	if R.configFile then
		R._saveAt = T() + .75;
	end;
	if #R.depWidgets > 0 then
		R._depsDirty = true;
		if not R._inDeps then
			R:_evalDeps();
		end;
	end;
end;
function rn._evalDeps(Y)
	Y._inDeps = true;
	Y._depsDirty = false;
	for R, f in ipairs(Y.depWidgets) do
		local A = f.depends;
		local k = true;
		if type(A) == "function" then
			local Y, R = pcall(A);
			k = Y and (R and true) or false;
		elseif type(A) == "table" and A.kind then
			local Y = A.value;
			k = ((Y ~= nil and Y ~= false)) and true or false;
			if A.kind == "dropdown" and A.multi then
				k = next(Y) ~= nil;
			end;
		elseif type(A) == "table" then
			local Y, R = A[1], A[2];
			k = Y ~= nil and Y.value == R;
		end;
		if k ~= f.depOk then
			f.depOk = k;
			if f.hideDisabled then
				Y._dirty = true;
			else
				f:_repaint();
			end;
		end;
	end;
	Y._inDeps = false;
end;
function rn.SetTitle(f, Y, R)
	f.title = tostring(Y or "");
	if R ~= nil then
		f.subtitle = tostring(R);
	end;
	f._dirty = true;
	return f;
end;
function rn.IsVisible(Y)
	return Y.visible;
end;
function rn.SetVisible(R, Y)
	Y = Y and true or false;
	if Y == R.visible then
		return R;
	end;
	R.visible = Y;
	if not Y then
		if ff._drop and ff._drop.win == R then
			df();
		end;
		if ff._pick and ff._pick.win == R then
			wf();
		end;
		if ff._focus and (ff._focus.target and ff._focus.target.win == R) then
			lf();
		end;
		if ff._listen and ff._listen.win == R then
			If(ff._listen, nil, true);
		end;
		if ff._cap and ((ff._cap.win == R or (ff._cap.wid and ff._cap.wid.win == R))) then
			ff._cap = nil;
		end;
		if pf then
			pf();
		end;
	end;
	ff:_wake();
	return R;
end;
function rn.Show(Y)
	return Y:SetVisible(true);
end;
function rn.Hide(Y)
	return Y:SetVisible(false);
end;
function rn.Toggle(Y)
	return Y:SetVisible(not Y.visible);
end;
function rn._contains(f, Y, R)
	return f.fadeV > 0 and c(Y, R, f.x, f.y, f.w, f.h);
end;
function rn._hideAll(Y)
	Wf(Y.nodes);
	for Y, R in ipairs(Y.widgets) do
		R.placed = false;
	end;
	Y._laidOut = false;
	Y._shownTab = nil;
end;
function rn._applyAlpha(Y)
	local R, f = Y.fadeV, ff.Opacity;
	local A = Y.nodes;
	for Y = 1, #A, 1 do
		local k = A[Y];
		tf(k, ((k.bg and f or 1)) * R);
	end;
end;
function rn._tabsShown(Y)
	if Y.showTabs ~= nil then
		return Y.showTabs and true or false;
	end;
	return #Y:_visibleTabs() > 1;
end;
function rn._tabLayout(A, Y, R, f)
	local k, Q, j = {}, {}, 0;
	for Y, R in ipairs(A.tabs) do
		R.hit = nil;
		if R.visible then
			local Y = qf(R.name) + 20;
			if #Q > 0 and j + Y > f then
				k[#k + 1] = Q;
				Q, j = {}, 0;
			end;
			Q[#Q + 1] = R;
			R._nw = Y;
			j = j + Y;
		end;
	end;
	if #Q > 0 then
		k[#k + 1] = Q;
	end;
	for A, k in ipairs(k) do
		local Q = 0;
		for Y, R in ipairs(k) do
			Q = Q + R._nw;
		end;
		local j = o(0, f - Q) / #k;
		local u = Y;
		for o, Q in ipairs(k) do
			local P = M(u + .5);
			u = (u + Q._nw) + j;
			local q = (o == #k) and (Y + f) or M(u + .5);
			Q.hit = {
					P,
					R + ((A - 1)) * jf.tabs,
					q - P,
					jf.tabs,
				};
		end;
	end;
	return o(1, #k) * jf.tabs;
end;
function rn._paintTabs(Y)
	local R = Y.tabRect;
	local f = ff.C;
	local A = Y:_activeTab();
	for k, o in ipairs(Y.tabs) do
		if not R then
			o.hit = nil;
		end;
		local Q = o.hit;
		if o.visible and Q then
			local R = Of(o.name, Q[3] - 8);
			local k = Q[1] + M(((Q[3] - qf(R))) / 2);
			local j = o == A;
			Ff(o.nText, R, k, (Q[2] + M(((Q[4] - jf.th)) / 2)) - 1, j and f.topAccent or ((Y._tabHover == o) and f.topText or f.topDim));
			if j then
				Y._ulGoalX, Y._ulGoalW, Y._ulY = k - 6, qf(R) + 12, (Q[2] + Q[4]) - 3;
			end;
		else
			Xf(o.nText);
		end;
	end;
	if not R or not Y._ulY then
		Xf(Y.ch.underline);
		return;
	end;
	if not Y._ulX or not ff.Settings.smoothScroll or Y._ulYWas ~= Y._ulY then
		Y._ulX, Y._ulW, Y._ulYWas = Y._ulGoalX, Y._ulGoalW, Y._ulY;
	end;
	af(Y.ch.underline, Y._ulX, Y._ulY, Y._ulW, 2, f.accent);
end;
function rn._paintBar(R, Y)
	local f = R.ch.bar;
	local A, k, o = R.x + 2, R.y + 2, R.w - 4;
	local Q = ff.Bar;
	if not Q.rainbow then
		af(f[1], A, k, o, 2, ff.C.accent);
		for Y = 2, Un, 1 do
			Xf(f[Y]);
		end;
		return;
	end;
	local j = (((Y * Q.speed) * Q.direction)) % 1;
	local u = o / Un;
	for Y = 1, Un, 1 do
		local R = A + M(((Y - 1)) * u);
		local o = A + M(Y * u);
		local P = ((j + (((Y - 1)) / Un) * Q.span)) % 1;
		af(f[Y], R, k, o - R, 2, C(P * 360));
	end;
end;
function rn._layoutColumn(A, Y, R, f)
	f = f or 0;
	local k = A.cols[R];
	local Q = A.hits[R];
	local j = 0;
	local u = jf.arrowH;
	local P = Y.content[R] > k.h;
	local q, g = k.y, k.y + k.h;
	if P then
		q, g = q + u, g - u;
	end;
	local O, N = k.x, k.w - jf.gutter;
	local E = Y.scroll[R];
	local T = q - E;
	local S = Y.cols[R];
	local r = ff.C;
	local U = A.ghits[R];
	local c = 0;
	for Y = 1, #S, 1 do
		local R = S[Y];
		if R.visible then
			local Y = T + jf.half;
			local f = Y + jf.gtop;
			if R.collapsible and (R.title ~= "" and (Y - jf.half >= q and (Y + jf.half) + 2 <= g)) then
				c = c + 1;
				local f = U[c];
				if not f then
					f = {};
					U[c] = f;
				end;
				f[1], f[2], f[3] = Y - jf.half, (Y + jf.half) + 2, R;
			end;
			for Y = 1, (R.collapsed and 0 or #R.widgets), 1 do
				local A = R.widgets[Y];
				if A:_shown() then
					A.px, A.py, A.pw = O + 1, f, N - 2;
					local Y = A:height();
					if f >= q and f + Y <= g then
						A.placed = true;
						A:paint();
						j = j + 1;
						local R = Q[j];
						if not R then
							R = {};
							Q[j] = R;
						end;
						R[1], R[2], R[3] = f, f + Y, A;
					else
						A:hideNodes();
					end;
					f = f + Y;
				else
					A:hideNodes();
				end;
			end;
			if R.collapsed then
				for Y = 1, #R.widgets, 1 do
					R.widgets[Y]:hideNodes();
				end;
			end;
			local A = R.collapsed and ((Y + jf.half) + 3) or (f + jf.gbot);
			R:_paintBox(O, Y, N, A, q, g);
			T = A + jf.ggap;
		else
			R:_hide();
		end;
	end;
	Q.n = j;
	U.n = c;
	local X = (T - jf.ggap) - ((q - E));
	Y.content[R] = X;
	if ((X > k.h)) ~= P and f < 2 then
		return A:_layoutColumn(Y, R, f + 1);
	end;
	local a = g - q;
	local F = o(0, X - a);
	Y.maxScroll[R] = F;
	if Y.target[R] > F then
		Y.target[R] = F;
	end;
	if E > F and f < 2 then
		Y.scroll[R] = F;
		return A:_layoutColumn(Y, R, f + 1);
	end;
	k.vt, k.vb = q, g;
	local t = A.sbars[R];
	if F > 0 then
		local Y = (k.x + k.w) - jf.sbw;
		af(t.track, Y, q, jf.sbw, a, r.track);
		local f = o(18, M((a * a) / X));
		local Q = q + M(((a - f)) * ((E / F)) + .5);
		local j = (ff._cap and (ff._cap.kind == "sbar" and (ff._cap.win == A and ff._cap.c == R)));
		af(t.thumb, Y, Q, jf.sbw, f, j and r.text or r.accent);
		k.sb = {
				Y - 3,
				q,
				jf.sbw + 6,
				a,
				f,
			};
	else
		Xf(t.track);
		Xf(t.thumb);
		k.sb = nil;
	end;
	if P then
		k.upR = {
				k.x,
				k.y,
				k.w,
				u - 1,
			};
		k.dnR = {
				k.x,
				g + 1,
				k.w,
				u - 1,
			};
	else
		k.upR, k.dnR = nil, nil;
	end;
	A:_paintArrows(R);
end;
function rn._paintArrows(R, Y)
	local f, A = R.cols[Y], R.sbars[Y];
	if not f.upR then
		xf.hide(A.upBg, A.up);
		xf.hide(A.dnBg, A.dn);
		return;
	end;
	local k = R:_activeTab();
	local M, o = k.scroll[Y], k.maxScroll[Y];
	local Q, j = f.upR, f.dnR;
	xf.paint(A.upBg, A.up, Q[1], Q[2], Q[3], Q[4], true, xf.state("col", R, Y, -1, M > .5));
	xf.paint(A.dnBg, A.dn, j[1], j[2], j[3], j[4], false, xf.state("col", R, Y, 1, M < o - .5));
end;
function rn._layout(Y)
	local R = ff.C;
	local f = Y.ch;
	local A, k = Jf();
	Y.w = U(Y.w, Y.minW, o(Y.minW, A));
	Y.h = U(Y.h, Y.minH, o(Y.minH, k));
	Y.x = U(Y.x, 40 - Y.w, A - 40);
	Y.y = U(Y.y, 0, k - 20);
	local Q, j, u, P = Y.x, Y.y, Y.w, Y.h;
	af(f.frame, Q, j, u, P, R.border);
	af(f.frameIn, Q + 1, j + 1, u - 2, P - 2, R.frameIn);
	af(f.bg, Q + 2, j + 2, u - 4, P - 4, R.bg);
	Y:_paintBar(ff._now or T());
	local q = j + 4;
	af(f.titleBg, Q + 2, q, u - 4, jf.title, R.topbar);
	local g = q + M(((jf.title - jf.th)) / 2);
	Ff(f.title, Of(Y.title, u - 24), (Q + 2) + jf.gpad, g, R.topText);
	if Y.subtitle and Y.subtitle ~= "" then
		local A = ((u - 24) - qf(Y.title)) - 16;
		local k = Of(Y.subtitle, A);
		Ff(f.subtitle, k, (((Q + u) - 2) - jf.gpad) - qf(k), g, R.topDim);
	else
		Xf(f.subtitle);
	end;
	Y.titleRect = {
			Q,
			j,
			u,
			(q + jf.title) - j,
		};
	local O = q + jf.title;
	af(f.sep1, Q + 2, O, u - 4, 1, R.sep);
	O = O + 1;
	if Y:_tabsShown() then
		local A = Y:_tabLayout(Q + 2, O, u - 4);
		af(f.tabBg, Q + 2, O, u - 4, A, R.topbar);
		Y.tabRect = {
				Q + 2,
				O,
				u - 4,
				A,
			};
		Y:_paintTabs();
		O = O + A;
		af(f.sep2, Q + 2, O, u - 4, 1, R.sep);
		O = O + 1;
	else
		Xf(f.tabBg);
		Xf(f.sep2);
		Y.tabRect = nil;
		Y:_paintTabs();
	end;
	local N = O + jf.pad;
	local E = ((j + P) - 2) - jf.pad;
	local S = Y.columns;
	local r = (Q + 2) + jf.pad;
	local c = (u - 4) - jf.pad * 2;
	local X = M(((c - ((S - 1)) * jf.colGap)) / S);
	for R = 1, S, 1 do
		local f = Y.cols[R];
		f.x = r + ((R - 1)) * ((X + jf.colGap));
		f.y = N;
		f.w = (R == S) and ((r + c) - f.x) or X;
		f.h = o(1, E - N);
	end;
	local a = Y:_activeTab();
	if Y._shownTab ~= a then
		if Y._shownTab then
			Y._shownTab:_hide();
		end;
		Y._shownTab = a;
	end;
	if Y._depsDirty then
		Y:_evalDeps();
	end;
	if a then
		for R = 1, S, 1 do
			Y:_layoutColumn(a, R);
		end;
	end;
	for R = S + 1, #Y.sbars, 1 do
		Xf(Y.sbars[R].track);
		Xf(Y.sbars[R].thumb);
	end;
	if Y.resizable then
		local A, k = (Q + u) - 4, (j + P) - 4;
		af(f.grip[1], A - 2, k - 2, 2, 2, R.outline);
		af(f.grip[2], A - 5, k - 2, 2, 2, R.outline);
		af(f.grip[3], A - 2, k - 5, 2, 2, R.outline);
		Y.gripRect = {
				(Q + u) - 12,
				(j + P) - 12,
				12,
				12,
			};
	else
		Y.gripRect = nil;
	end;
	Y._dirty = false;
	Y._laidOut = true;
	if ff._drop and ff._drop.win == Y then
		if ff._drop.placed then
			yf();
		else
			df();
		end;
	end;
	if ff._pick and ff._pick.win == Y then
		mf();
	end;
end;
function rn._rowAt(f, Y, R)
	local A = f.hits[Y];
	for Y = 1, A.n, 1 do
		local f = A[Y];
		if R >= f[1] and R < f[2] then
			return f[3];
		end;
	end;
	return nil;
end;
function rn._groupAt(f, Y, R)
	local A = f.ghits[Y];
	for Y = 1, A.n or 0, 1 do
		local f = A[Y];
		if R >= f[1] and R < f[2] then
			return f[3];
		end;
	end;
	return nil;
end;
function rn._colAt(f, Y, R)
	for A = 1, f.columns, 1 do
		local k = f.cols[A];
		if c(Y, R, k.x, k.y, k.w, k.h) then
			return A, k;
		end;
	end;
	return nil;
end;
function rn._scrollBy(f, Y, R)
	local A = f:_activeTab();
	if not A then
		return;
	end;
	A.target[Y] = U(A.target[Y] + R, 0, A.maxScroll[Y]);
end;
function rn._frame(f, Y, R)
	if not f._booted then
		f._booted = true;
		f:_boot();
	end;
	local A = f.visible and 1 or 0;
	if f.fadeV ~= A then
		if ff.Settings.fade then
			local Y = R / .12;
			if A > f.fadeV then
				f.fadeV = Q(A, f.fadeV + o(Y, .05));
			else
				f.fadeV = o(A, f.fadeV - o(Y, .05));
			end;
		else
			f.fadeV = A;
		end;
		if f.fadeV <= 0 then
			f:_hideAll();
			return;
		end;
		if f._dirty or not f._laidOut then
			f:_layout();
		end;
		f:_applyAlpha();
	end;
	if f.fadeV <= 0 then
		return;
	end;
	local k = f:_activeTab();
	if k then
		for Y = 1, f.columns, 1 do
			local A, M = k.scroll[Y], k.target[Y];
			if A ~= M then
				local o = M;
				if ff.Settings.smoothScroll then
					o = A + ((M - A)) * Q(1, R * 16);
					if j(M - o) < .5 then
						o = M;
					end;
				end;
				k.scroll[Y] = o;
				if ff._drop and ff._drop.win == f then
					df();
				end;
				if not f._dirty then
					f:_layoutColumn(k, Y);
				end;
				ff._hoverDirty = true;
			end;
		end;
	end;
	if #f.depWidgets > 0 and Y >= ((f._depsAt or 0)) then
		f._depsAt = Y + .25;
		f:_evalDeps();
	end;
	if f._ulX and (f._ulGoalX and ((f._ulX ~= f._ulGoalX or f._ulW ~= f._ulGoalW))) then
		local Y = Q(1, R * 18);
		f._ulX = f._ulX + ((f._ulGoalX - f._ulX)) * Y;
		f._ulW = f._ulW + ((f._ulGoalW - f._ulW)) * Y;
		if j(f._ulX - f._ulGoalX) < .5 and j(f._ulW - f._ulGoalW) < .5 then
			f._ulX, f._ulW = f._ulGoalX, f._ulGoalW;
		end;
		if f.tabRect and (f._ulY and not f._dirty) then
			af(f.ch.underline, f._ulX, f._ulY, f._ulW, 2, ff.C.accent);
		end;
	end;
	if f._dirty then
		f:_layout();
	end;
end;
function rn._boot(Y)
	if Y._depsDirty then
		Y:_evalDeps();
	end;
	if not Y._settingsLoaded then
		Y:LoadSettings();
	end;
	if Y.autoloadEnabled then
		local R = Y:GetAutoload();
		if R then
			Y:LoadConfig(R);
		end;
	end;
end;
function rn.Unload(Y)
	if Y._unloading then
		return;
	end;
	Y._unloading = true;
	Mf("unload", Y.onUnload, Y);
	Y:Destroy();
	if #ff.Windows == 0 and not ff._dead then
		ff:Unload();
	end;
end;
function rn.Destroy(Y)
	if not Y.alive then
		return;
	end;
	if Y._saveAt then
		pcall(Y.SaveSettings, Y);
	end;
	Y.alive = false;
	Y.visible = false;
	for R = #ff.Windows, 1, -1 do
		if ff.Windows[R] == Y then
			E(ff.Windows, R);
		end;
	end;
	Xn();
	if ff._drop and ff._drop.win == Y then
		df();
	end;
	if ff._pick and ff._pick.win == Y then
		wf();
	end;
	if ff._focus and (ff._focus.target and ff._focus.target.win == Y) then
		ff._focus = nil;
	end;
	if ff._listen and ff._listen.win == Y then
		ff._listen = nil;
	end;
	if ff._hover and ff._hover.win == Y then
		ff._hover = nil;
	end;
	if ff._arrow and ff._arrow.win == Y then
		ff._arrow = nil;
	end;
	if ff._cap and ((ff._cap.win == Y or (ff._cap.wid and ff._cap.wid.win == Y))) then
		ff._cap = nil;
	end;
	if pf then
		pf();
	end;
	for R = #ff._binds, 1, -1 do
		if ff._binds[R].win == Y then
			E(ff._binds, R);
		end;
	end;
	for R in pairs(ff._rainbow) do
		if R.win == Y then
			ff._rainbow[R] = nil;
		end;
	end;
	for R in pairs(ff._pending) do
		if R.win == Y then
			ff._pending[R] = nil;
		end;
	end;
	for R, f in pairs(ff.Flags) do
		if f.win == Y then
			ff.Flags[R] = nil;
		end;
	end;
	local R = Y.nodes;
	Y.nodes = {};
	Hf(R);
	if bf.visible then
		bf.dirty = true;
	end;
	if ff._hoverGroup and ff._hoverGroup.win == Y then
		ff._hoverGroup = nil;
	end;
end;
Jf = function()
		local Y = T();
		if not ff._vpAt or Y - ff._vpAt > 1 then
			ff._vpAt = Y;
			local R, f, A = pcall(function()
					local Y = workspace.CurrentCamera.ViewportSize;
					return Y.X, Y.Y;
				end);
			if R and (type(f) == "number" and f > 0) then
				ff._vpW, ff._vpH = f, A;
			end;
		end;
		return ff._vpW or 1920, ff._vpH or 1080;
	end;
local an = {
		rows = {},
		cap = 12,
		searchAt = 8,
		first = 1,
		list = {},
		query = "",
		was = {},
		ah = 0,
		hh = 0,
	};
function an.filter(Y)
	local R = an.list;
	for Y = #R, 1, -1 do
		R[Y] = nil;
	end;
	local f = an.query:lower();
	for A = 1, #Y.values, 1 do
		local k = Y.values[A];
		if f == "" or (k:lower()):find(f, 1, true) then
			R[#R + 1] = k;
		end;
	end;
	return R;
end;
local function Fn()
	if an.edge then
		return;
	end;
	local Y = ff._ov;
	an.edge = cf(Y, "Square", rf.pop);
	an.bg = cf(Y, "Square", rf.popIn);
	for R = 1, an.cap, 1 do
		an.rows[R] = { hover = cf(Y, "Square", rf.popBg), mark = cf(Y, "Square", rf.popCtl), text = cf(Y, "Text", rf.popText) };
	end;
	an.thumb = cf(Y, "Square", rf.popFill);
	an.headBg = cf(Y, "Square", rf.popBg);
	an.head = cf(Y, "Text", rf.popText);
	an.upBg, an.dnBg = cf(Y, "Square", rf.popBg), cf(Y, "Square", rf.popBg);
	an.up, an.dn = {}, {};
	for R = 1, 4, 1 do
		an.up[R] = cf(Y, "Square", rf.popText);
		an.dn[R] = cf(Y, "Square", rf.popText);
	end;
end;
local function tn(Y)
	Y(an.edge);
	Y(an.bg);
	Y(an.thumb);
	Y(an.headBg);
	Y(an.head);
	Y(an.upBg);
	Y(an.dnBg);
	for R = 1, 4, 1 do
		Y(an.up[R]);
		Y(an.dn[R]);
	end;
	for R = 1, an.cap, 1 do
		local f = an.rows[R];
		Y(f.hover);
		Y(f.mark);
		Y(f.text);
	end;
end;
yf = function()
		local Y = ff._drop;
		if not Y or not an.edge then
			return;
		end;
		local R = ff.C;
		local f = qf("type to search");
		for R = 1, #Y.values, 1 do
			f = o(f, qf(Y.values[R]));
		end;
		local A = an.filter(Y);
		local k = Y.multi and (jf.cb + 6) or 0;
		local j = U(((f + jf.gpad * 2) + k) + 6, 90, o(90, Y.pw - jf.gpad * 2));
		local u = jf.R;
		local P = an.search and u or 0;
		local q = jf.arrowH;
		local g = #Y.values;
		local O, N = Jf();
		local function E(Y)
			local R = Q(g, an.cap);
			local f = g > R;
			while R > 1 and ((R * u + 2) + P) + ((f and q * 2 or 0)) > Y do
				R = R - 1;
				f = true;
			end;
			R = o(1, R);
			return R, g > R;
		end;
		local T = (N - 4) - ((Y.py + jf.R));
		local S, r = E(T);
		local c = Y.py + jf.R;
		if S < Q(g, an.cap) and Y.py - 4 > T then
			S, r = E(Y.py - 4);
			c = Y.py - ((((S * u + 2) + P) + ((r and q * 2 or 0))));
		end;
		local X = r and q or 0;
		local a = ((S * u + 2) + P) + X * 2;
		local F = ((Y.px + Y.pw) - jf.gpad) - j;
		an.x, an.y, an.w, an.h, an.n, an.rh, an.hh, an.ah = F, c, j, a, S, u, P, X;
		af(an.edge, F, c, j, a, R.outlineHi);
		af(an.bg, F + 1, c + 1, j - 2, a - 2, R.group);
		if an.search then
			af(an.headBg, F + 1, c + 1, j - 2, u, R.control);
			local Y = an.query;
			Ff(an.head, Of(Y == "" and "type to search" or ("search: " .. Y), j - jf.gpad * 2), F + jf.gpad, (c + 1) + jf.ty, Y == "" and R.textOff or R.accent);
		else
			Xf(an.headBg);
			Xf(an.head);
		end;
		local t = ((c + 1) + P) + X;
		local D = #A;
		an.first = U(an.first, 1, o(1, (D - S) + 1));
		if r then
			an.upR = {
					F + 1,
					(c + 1) + P,
					j - 2,
					X - 1,
				};
			an.dnR = {
					F + 1,
					t + S * u,
					j - 2,
					X - 1,
				};
			local Y, R = an.upR, an.dnR;
			xf.paint(an.upBg, an.up, Y[1], Y[2], Y[3], Y[4], true, xf.state("drop", nil, nil, -1, an.first > 1));
			xf.paint(an.dnBg, an.dn, R[1], R[2], R[3], R[4], false, xf.state("drop", nil, nil, 1, (an.first + S) - 1 < D));
		else
			an.upR, an.dnR = nil, nil;
			xf.hide(an.upBg, an.up);
			xf.hide(an.dnBg, an.dn);
		end;
		local W = D > S;
		local H = ((j - jf.gpad * 2) - k) - ((W and 6 or 0));
		for f = 1, an.cap, 1 do
			local o = an.rows[f];
			local Q = (an.first + f) - 1;
			if f <= S and Q <= D then
				local P = t + ((f - 1)) * u;
				local q = A[Q];
				local g = Y:_isSelected(q);
				if an.hover == f then
					af(o.hover, F + 1, P, (j - 2) - ((W and 5 or 0)), u, R.hover);
				else
					Xf(o.hover);
				end;
				local O = F + jf.gpad;
				if Y.multi then
					local Y = jf.cb - 2;
					af(o.mark, O, P + M(((u - Y)) / 2), Y, Y, g and R.accent or R.outline);
					O = O + k;
				else
					Xf(o.mark);
				end;
				Ff(o.text, Of(q, H), O, P + jf.ty, g and R.accent or R.text);
			else
				Xf(o.hover);
				Xf(o.mark);
				Xf(o.text);
			end;
		end;
		if W then
			local Y = S * u;
			local f = o(10, M((Y * S) / D));
			local A = t + M((((Y - f)) * ((an.first - 1))) / ((D - S)) + .5);
			af(an.thumb, (F + j) - 5, A, 2, f, R.accent);
		else
			Xf(an.thumb);
		end;
	end;
Cf = function(Y)
		if ff._drop then
			df();
		end;
		Fn();
		ff._drop = Y;
		an.hover = nil;
		an.first = 1;
		an.query = "";
		an.search = #Y.values > an.searchAt or Y.o.search == true;
		if an.search then
			for Y, R in ipairs(l) do
				an.was[R[1]] = J(R[1]);
			end;
		end;
		if not Y.multi then
			for R = 1, #Y.values, 1 do
				if Y.values[R] == Y.value then
					an.first = R - M(an.cap / 2);
				end;
			end;
		end;
		yf();
		if Y.placed then
			Y:paint();
		end;
		ff:_wake();
	end;
df = function()
		local Y = ff._drop;
		ff._drop = nil;
		if ff._arrow and ff._arrow.kind == "drop" then
			ff._arrow = nil;
		end;
		if an.edge then
			tn(Xf);
		end;
		if Y and Y.placed then
			Y:paint();
		end;
	end;
local function Dn(Y, R)
	return ff._drop and (an.x and c(Y, R, an.x, an.y, an.w, an.h));
end;
local function Wn(Y)
	local R = ((an.y + 1) + an.hh) + an.ah;
	if Y < R then
		return nil;
	end;
	local f = M(((Y - R)) / an.rh) + 1;
	if f >= 1 and f <= an.n then
		return f;
	end;
	return nil;
end;
local function Hn(Y)
	local R = an.first;
	an.first = an.first + Y;
	yf();
	return an.first ~= R;
end;
local xn = {};
local Cn, dn = 24, 36;
local yn;
local function Zn()
	if xn.frame then
		return;
	end;
	local Y = ff._ov;
	local function R(R)
		return cf(Y, "Square", R);
	end;
	local function f(R)
		return cf(Y, "Text", R);
	end;
	xn.all = {};
	xn.frame = R(rf.pop);
	xn.frameIn = R(rf.popIn);
	xn.bg = R(rf.popBg);
	xn.bar = R(rf.popCtl);
	xn.title = f(rf.popText);
	xn.svEdge = R(rf.popCtl);
	xn.svBase = R(rf.popCtlIn);
	xn.svW, xn.svB = {}, {};
	for Y = 1, Cn, 1 do
		xn.svW[Y] = R(rf.popFill);
		tf(xn.svW[Y], 1 - ((Y - .5)) / Cn);
	end;
	for Y = 1, Cn, 1 do
		xn.svB[Y] = R(rf.popOver);
		tf(xn.svB[Y], ((Y - .5)) / Cn);
	end;
	xn.svCur = R(rf.popOver2);
	xn.svCurIn = R(rf.popText);
	xn.hueEdge = R(rf.popCtl);
	xn.hue = {};
	yn = {};
	for Y = 1, dn, 1 do
		xn.hue[Y] = R(rf.popCtlIn);
		yn[Y] = a(F(((Y - .5)) / dn, 1, 1));
	end;
	xn.hueCur = R(rf.popFill);
	xn.hueCurIn = R(rf.popOver);
	xn.prevEdge = R(rf.popCtl);
	xn.prevFill = R(rf.popCtlIn);
	xn.rgbBox = R(rf.popCtl);
	xn.rgbIn = R(rf.popCtlIn);
	xn.rgbFill = R(rf.popFill);
	xn.rgbText = f(rf.popText);
	xn.doneEdge = R(rf.popCtl);
	xn.doneIn = R(rf.popCtlIn);
	xn.doneText = f(rf.popText);
	xn.hexLabel = f(rf.popText);
	xn.hexEdge = R(rf.popCtl);
	xn.hexIn = R(rf.popCtlIn);
	xn.hexText = f(rf.popText);
	xn.hexCaret = R(rf.popTop);
	xn.recLabel = f(rf.popText);
	xn.rec = {};
	for Y = 1, 6, 1 do
		xn.rec[Y] = { edge = R(rf.popCtl), fill = R(rf.popCtlIn) };
	end;
end;
local function wn(Y)
	for R, f in ipairs({
		"frame",
		"frameIn",
		"bg",
		"bar",
		"title",
		"svEdge",
		"svBase",
		"svCur",
		"svCurIn",
		"hueEdge",
		"hueCur",
		"hueCurIn",
		"prevEdge",
		"prevFill",
		"rgbBox",
		"rgbIn",
		"rgbFill",
		"rgbText",
		"doneEdge",
		"doneIn",
		"doneText",
		"hexLabel",
		"hexEdge",
		"hexIn",
		"hexText",
		"hexCaret",
		"recLabel",
	}) do
		Y(xn[f]);
	end;
	for R = 1, Cn, 1 do
		Y(xn.svW[R]);
		Y(xn.svB[R]);
	end;
	for R = 1, dn, 1 do
		Y(xn.hue[R]);
	end;
	for R = 1, 6, 1 do
		Y(xn.rec[R].edge);
		Y(xn.rec[R].fill);
	end;
end;
local function mn()
	local Y = xn.g or {};
	xn.g = Y;
	Y.pad = 8;
	Y.svW = o(150, M(jf.cw * 19));
	Y.svH = M(Y.svW * .75);
	Y.hueW = 12;
	Y.W = ((Y.pad * 2 + Y.svW) + 6) + Y.hueW;
	Y.svY = jf.R + 4;
	Y.r2 = (Y.svY + Y.svH) + 6;
	Y.r3 = (Y.r2 + jf.R) + 4;
	Y.r4 = (Y.r3 + jf.R) + 4;
	Y.H = ((Y.r4 + jf.R) + Y.pad) - 2;
	return Y;
end;
mf = function()
		local Y = ff._pick;
		if not Y or not xn.frame then
			return;
		end;
		local R = ff.C;
		local f = mn();
		local A, k = xn.x, xn.y;
		local o, Q, j = f.W, f.H, f.pad;
		af(xn.frame, A, k, o, Q, R.border);
		af(xn.frameIn, A + 1, k + 1, o - 2, Q - 2, R.frameIn);
		af(xn.bg, A + 2, k + 2, o - 4, Q - 4, R.group);
		af(xn.bar, A + 2, k + 2, o - 4, 2, R.accent);
		Ff(xn.title, Of(Y.title .. " color", o - j * 2), A + j, (k + 4) + M(((jf.R - jf.th)) / 2), R.text);
		local u, q, g, O = A + j, k + f.svY, f.svW, f.svH;
		af(xn.svEdge, u - 1, q - 1, g + 2, O + 2, R.outline);
		if xn.baseHue ~= Y.h or not xn.baseC then
			xn.baseHue = Y.h;
			xn.baseC = a(F(Y.h, 1, 1));
		end;
		af(xn.svBase, u, q, g, O, xn.baseC);
		for Y = 1, Cn, 1 do
			local f, A = u + M((((Y - 1)) * g) / Cn), u + M((Y * g) / Cn);
			af(xn.svW[Y], f, q, A - f, O, R.white);
			local k, o = q + M((((Y - 1)) * O) / Cn), q + M((Y * O) / Cn);
			af(xn.svB[Y], u, k, g, o - k, R.black);
		end;
		local N, E = u + Y.s * g, q + ((1 - Y.v)) * O;
		af(xn.svCur, N - 3, E - 3, 7, 7, R.white);
		af(xn.svCurIn, N - 2, E - 2, 5, 5, Y.value);
		f.sv = {
				u,
				q,
				g,
				O,
			};
		local T = (u + g) + 6;
		af(xn.hueEdge, T - 1, q - 1, f.hueW + 2, O + 2, R.outline);
		for Y = 1, dn, 1 do
			local R, A = q + M((((Y - 1)) * O) / dn), q + M((Y * O) / dn);
			af(xn.hue[Y], T, R, f.hueW, A - R, yn[Y]);
		end;
		local S = q + Y.h * O;
		af(xn.hueCur, T - 2, S - 2, f.hueW + 4, 4, R.white);
		af(xn.hueCurIn, T - 1, S - 1, f.hueW + 2, 2, R.black);
		f.hue = {
				T - 2,
				q - 2,
				f.hueW + 4,
				O + 4,
			};
		local r = k + f.r2;
		local U = M(f.svW * .38);
		af(xn.prevEdge, A + j, r, U, jf.R, R.outline);
		af(xn.prevFill, (A + j) + 1, r + 1, U - 2, jf.R - 2, Y.value);
		local c, X = ((A + j) + U) + 8, r + M(((jf.R - jf.cb)) / 2);
		af(xn.rgbBox, c, X, jf.cb, jf.cb, R.outline);
		af(xn.rgbIn, c + 1, X + 1, jf.cb - 2, jf.cb - 2, R.control);
		if Y.rainbow then
			af(xn.rgbFill, c + 2, X + 2, jf.cb - 4, jf.cb - 4, R.accent);
		else
			Xf(xn.rgbFill);
		end;
		Ff(xn.rgbText, "rgb", (c + jf.cb) + 5, r + jf.ty, R.text);
		f.rgb = {
				c - 2,
				r,
				((jf.cb + 5) + qf("rgb")) + 4,
				jf.R,
			};
		local t = qf("done") + 16;
		local D = ((A + o) - j) - t;
		local W = xn.hot == "done";
		af(xn.doneEdge, D, r, t, jf.R, W and R.text or R.outlineHi);
		af(xn.doneIn, D + 1, r + 1, t - 2, jf.R - 2, W and R.controlHi or R.control);
		Ff(xn.doneText, "done", D + 8, r + jf.ty, R.text);
		f.done = {
				D,
				r,
				t,
				jf.R,
			};
		local H = k + f.r3;
		local x = ((A + j) + qf("recent")) + 8;
		local C = ((A + o) - j) - x;
		Ff(xn.hexLabel, "hex", A + j, H + jf.ty, R.textDim);
		local d = ff._focus;
		local y = d and d.target == xn;
		af(xn.hexEdge, x, H, C, jf.R, y and R.accent or R.outline);
		af(xn.hexIn, x + 1, H + 1, C - 2, jf.R - 2, R.control);
		local Z = y and d.buf or Y:GetHex();
		Ff(xn.hexText, Z, x + 5, H + jf.ty, R.text);
		if y and d.caretOn then
			af(xn.hexCaret, (x + 5) + M(Pf(P(d.buf, 1, d.caret)) + .5), H + jf.ty, 1, jf.th, R.text);
		else
			Xf(xn.hexCaret);
		end;
		f.hex = {
				x,
				H,
				C,
				jf.R,
			};
		local w = k + f.r4;
		Ff(xn.recLabel, "recent", A + j, w + jf.ty, R.textDim);
		local m = jf.cb + 3;
		f.rec = {};
		for Y = 1, 6, 1 do
			local A = ff._recent[Y];
			local k = x + ((Y - 1)) * ((m + 4));
			if A then
				af(xn.rec[Y].edge, k, w + M(((jf.R - m)) / 2), m, m, R.outline);
				if not A.c3 then
					A.c3 = a(A);
				end;
				af(xn.rec[Y].fill, k + 1, (w + M(((jf.R - m)) / 2)) + 1, m - 2, m - 2, A.c3);
				f.rec[Y] = {
						k,
						w,
						m,
						jf.R,
					};
			else
				Xf(xn.rec[Y].edge);
				Xf(xn.rec[Y].fill);
			end;
		end;
	end;
local function Kn(Y)
	local R, f, A = r(Y[1]), r(Y[2]), r(Y[3]);
	for Y = #ff._recent, 1, -1 do
		local k = ff._recent[Y];
		if k[1] == R and (k[2] == f and k[3] == A) then
			E(ff._recent, Y);
		end;
	end;
	table.insert(ff._recent, 1, { R, f, A });
	while #ff._recent > 6 do
		E(ff._recent);
	end;
end;
Zf = function(Y)
		if ff._pick then
			wf();
		end;
		Zn();
		ff._pick = Y;
		xn.start = { r(Y.rgb[1]), r(Y.rgb[2]), r(Y.rgb[3]) };
		local R = mn();
		local f = Y.win;
		local A, k = Jf();
		local M = (f.x + f.w) + 6;
		if M + R.W > A - 4 then
			M = (f.x - R.W) - 6;
		end;
		if M < 4 then
			M = U((Y.px + Y.pw) - R.W, 4, (A - R.W) - 4);
		end;
		xn.x = M;
		xn.y = U(Y.py - 8, 4, o(4, (k - R.H) - 4));
		xn.hot = nil;
		mf();
		Y:_repaint();
		ff:_wake();
	end;
wf = function()
		local Y = ff._pick;
		if not Y then
			return;
		end;
		if ff._focus and ff._focus.target == xn then
			lf();
		end;
		ff._pick = nil;
		local R = xn.start;
		if R and ((r(Y.rgb[1]) ~= R[1] or r(Y.rgb[2]) ~= R[2] or r(Y.rgb[3]) ~= R[3])) then
			Kn(Y.rgb);
		end;
		if Y._pending then
			Y:_fire();
			ff._pending[Y] = nil;
		end;
		wn(Xf);
		Y:_repaint();
	end;
local function ln(Y, R)
	return ff._pick and (xn.x and (xn.g and c(Y, R, xn.x, xn.y, xn.g.W, xn.g.H)));
end;
local function sn(Y, R, f)
	local A, k = ff._pick, xn.g;
	if not A then
		return;
	end;
	if Y == "sv" then
		local Y = k.sv;
		A:_setHSV(A.h, U(((R - Y[1])) / Y[3], 0, 1), 1 - U(((f - Y[2])) / Y[4], 0, 1), true);
	else
		local Y = k.sv;
		A:_setHSV(U(((f - Y[2])) / Y[4], 0, .9999), A.s, A.v, true);
	end;
	A:_fireSoon();
end;
local function Bn(Y, R)
	local f, A = ff._pick, xn.g;
	if c(Y, R, A.sv[1], A.sv[2], A.sv[3], A.sv[4]) then
		if f.rainbow then
			f:SetRainbow(false);
		end;
		ff._cap = { kind = "sv", win = f.win };
		sn("sv", Y, R);
	elseif c(Y, R, A.hue[1], A.hue[2], A.hue[3], A.hue[4]) then
		if f.rainbow then
			f:SetRainbow(false);
		end;
		ff._cap = { kind = "hue", win = f.win };
		sn("hue", Y, R);
	elseif c(Y, R, A.rgb[1], A.rgb[2], A.rgb[3], A.rgb[4]) then
		f:SetRainbow(not f.rainbow);
	elseif c(Y, R, A.done[1], A.done[2], A.done[3], A.done[4]) then
		wf();
	elseif c(Y, R, A.hex[1], A.hex[2], A.hex[3], A.hex[4]) then
		Kf({
			target = xn,
			buf = f:GetHex(),
			caret = #f:GetHex(),
			maxLength = 7,
			commit = function(Y)
				local R = W(Y);
				if R and ff._pick == f then
					if f.rainbow then
						f:SetRainbow(false);
					end;
					f:_setRGB(R);
				end;
			end,
			refresh = function()
				mf();
			end,
		});
	else
		for k = 1, 6, 1 do
			local M = A.rec[k];
			if M and (c(Y, R, M[1], M[2], M[3], M[4]) and ff._recent[k]) then
				if f.rainbow then
					f:SetRainbow(false);
				end;
				f:_setRGB(ff._recent[k]);
				return;
			end;
		end;
	end;
end;
local In = { lines = {} };
local function pn()
	if In.edge then
		return;
	end;
	local Y = ff._ov;
	In.edge = cf(Y, "Square", rf.tip);
	In.bg = cf(Y, "Square", rf.tipIn);
	In.title = cf(Y, "Text", rf.tipText);
	for R = 1, 6, 1 do
		In.lines[R] = cf(Y, "Text", rf.tipText);
	end;
end;
local function bn(Y, R, f)
	pn();
	local A = ff.C;
	local k = Y._tipLines or {};
	local M = Y._tipTitle;
	local j = M and qf(M) or 0;
	for Y = 1, Q(#k, 6), 1 do
		j = o(j, qf(k[Y]));
	end;
	local u = jf.th + 3;
	local P = (((M and u or 0)) + Q(#k, 6) * u) + 8;
	local q = j + 14;
	local g, O = Jf();
	local N = U(R + 14, 4, (g - q) - 4);
	local E = f + 18;
	if E + P > O - 4 then
		E = (f - P) - 6;
	end;
	local T = Y._badge and vf(Y) or A.accent;
	af(In.edge, N, E, q, P, T);
	af(In.bg, N + 1, E + 1, q - 2, P - 2, A.group);
	local S = E + 4;
	if M then
		Ff(In.title, M, N + 7, S, T);
		S = S + u;
	else
		Xf(In.title);
	end;
	for Y = 1, 6, 1 do
		if Y <= #k then
			Ff(In.lines[Y], k[Y], N + 7, S, A.text);
			S = S + u;
		else
			Xf(In.lines[Y]);
		end;
	end;
	In.shown = Y;
end;
pf = function()
		if In.shown and In.edge then
			Xf(In.edge);
			Xf(In.bg);
			Xf(In.title);
			for Y = 1, 6, 1 do
				Xf(In.lines[Y]);
			end;
		end;
		In.shown = nil;
	end;
local Jn = 6;
local en = { pool = {}, active = {} };
local function Gn()
	local Y = ff._ov;
	local R = {
			edge = cf(Y, "Square", rf.toast),
			bg = cf(Y, "Square", rf.toastIn),
			bar = cf(Y, "Square", rf.toastFill),
			prog = cf(Y, "Square", rf.toastFill),
			lines = {},
		};
	for f = 1, 3, 1 do
		R.lines[f] = cf(Y, "Text", rf.toastText);
	end;
	R.all = {
			R.edge,
			R.bg,
			R.bar,
			R.prog,
			R.lines[1],
			R.lines[2],
			R.lines[3],
		};
	return R;
end;
function ff.Notify(Y, R, f, A)
	local k, M, o, Q;
	if Y == ff then
		k, M, o = R, f, A;
	else
		k, M, o = Y, R, f;
	end;
	if type(k) == "table" then
		M = k.duration or k.time or M;
		o = k.color or o;
		Q = k.key;
		k = ((k.title and (tostring(k.title) .. "\n") or "")) .. tostring(k.text or k.content or "");
	end;
	if ff._dead then
		return;
	end;
	local j = Tf(tostring(k or ""), 44);
	while #j > 3 do
		E(j);
	end;
	if Q ~= nil then
		for Y, R in ipairs(en.active) do
			if R.key == Q then
				R.text, R.color, R.dur = j, o, tonumber(M) or 4;
				R.t0 = ((ff._now or T())) - .2;
				ff:_wake();
				return;
			end;
		end;
	end;
	local u;
	if #en.pool > 0 then
		u = E(en.pool);
	elseif #en.active + #en.pool < Jn then
		u = Gn();
	else
		u = E(en.active, 1);
		Wf(u.all);
	end;
	u.text = j;
	u.key = Q;
	u.t0 = ff._now or T();
	u.dur = tonumber(M) or 4;
	u.color = o;
	en.active[#en.active + 1] = u;
	ff:_wake();
end;
local function hn(Y)
	local R = en.active;
	if #R == 0 then
		return;
	end;
	local f = ff.C;
	local A, k = Jf();
	local j = k - 16;
	local u = jf.th + 3;
	for k = #R, 1, -1 do
		local P = R[k];
		local q = Y - P.t0;
		if q > P.dur + .3 then
			Wf(P.all);
			E(R, k);
			en.pool[#en.pool + 1] = P;
		else
			local Y = 150;
			for R = 1, #P.text, 1 do
				Y = o(Y, qf(P.text[R]) + 22);
			end;
			local R = #P.text * u + 12;
			j = j - R;
			local k = Q(1, q / .18);
			k = 1 - ((1 - k)) * ((1 - k));
			local g = q > P.dur and ((q - P.dur)) / .3 or 0;
			local O = (((A - 16) - Y) + M(((1 - k)) * ((Y + 24)))) + M((g * g) * ((Y + 24)));
			local N = P.color or f.accent;
			af(P.edge, O, j, Y, R, f.border);
			af(P.bg, O + 1, j + 1, Y - 2, R - 2, f.group);
			af(P.bar, O + 1, j + 1, 2, R - 2, N);
			local E = 1 - U(q / P.dur, 0, 1);
			local T = M(((Y - 4)) * E);
			if T > 0 then
				af(P.prog, O + 3, (j + R) - 2, T, 1, N);
			else
				Xf(P.prog);
			end;
			for Y = 1, 3, 1 do
				if Y <= #P.text then
					Ff(P.lines[Y], P.text[Y], O + 11, (j + 6) + ((Y - 1)) * u, f.text);
				else
					Xf(P.lines[Y]);
				end;
			end;
			local S = 1 - U(g, 0, 1);
			for Y = 1, #P.all, 1 do
				tf(P.all[Y], S);
			end;
			j = j - 6;
		end;
	end;
end;
local vn = { visible = false };
local function Ln()
	if not vn.edge then
		return;
	end;
	if not vn.visible then
		Xf(vn.edge);
		Xf(vn.inner);
		Xf(vn.bg);
		Xf(vn.bar);
		Xf(vn.text);
		return;
	end;
	local Y = ff.C;
	local R = { vn.label or "ui" };
	if b.ping then
		local Y, f = pcall(GetPingValue);
		if Y and tonumber(f) then
			R[#R + 1] = M(tonumber(f)) .. "ms";
		end;
	end;
	if os and type(os.date) == "function" then
		local Y, f = pcall(os.date, "%H:%M:%S");
		if Y and type(f) == "string" then
			R[#R + 1] = f;
		end;
	end;
	local f = N(R, " | ");
	local A, k = qf(f) + 16, jf.R + 4;
	local o = Jf();
	local Q = vn.x or ((o - A) - 16);
	local j = vn.y or 16;
	vn.rect = {
			Q,
			j,
			A,
			k,
		};
	af(vn.edge, Q, j, A, k, Y.border);
	af(vn.inner, Q + 1, j + 1, A - 2, k - 2, Y.frameIn);
	af(vn.bg, Q + 2, j + 2, A - 4, k - 4, Y.group);
	af(vn.bar, Q + 2, j + 2, A - 4, 2, Y.accent);
	Ff(vn.text, f, Q + 8, (j + 2) + M((((k - 2) - jf.th)) / 2), Y.text);
end;
bf.rows = {};
local function nn(Y)
	local R = bf.rows[Y];
	if not R then
		R = { name = cf(ff._ov, "Text", rf.markText), key = cf(ff._ov, "Text", rf.markText) };
		bf.rows[Y] = R;
	end;
	return R;
end;
local function Vn()
	bf.dirty = false;
	if not bf.edge then
		return;
	end;
	if not bf.visible then
		for Y, R in ipairs({
			"edge",
			"inner",
			"bg",
			"bar",
			"title",
			"rule",
		}) do
			Xf(bf[R]);
		end;
		for Y = 1, #bf.rows, 1 do
			Xf(bf.rows[Y].name);
			Xf(bf.rows[Y].key);
		end;
		bf.rect = nil;
		return;
	end;
	local Y = ff.C;
	local R = {};
	for Y, f in ipairs(ff._binds) do
		if f.vk and (f.win.alive and (f.o.list ~= false and f:_enabled())) then
			local Y = (f.text ~= "" and f.text) or (f.host and f.host.text) or "keybind";
			R[#R + 1] = { Y, "[" .. (((f.value or "-")) .. "]"), f:GetState() and true or false };
		end;
	end;
	local f = jf.th + 3;
	local A, k = qf("keybinds"), 0;
	for Y, R in ipairs(R) do
		A, k = o(A, qf(R[1])), o(k, qf(R[2]));
	end;
	local Q = o(150, (A + k) + 30);
	local j = ((jf.R + 6) + #R * f) + 2;
	local u, P = Jf();
	local q = U(bf.x or 16, 0, o(0, u - Q));
	local g = U(bf.y or M(P * .35), 0, o(0, P - j));
	bf.rect = {
			q,
			g,
			Q,
			j,
		};
	af(bf.edge, q, g, Q, j, Y.border);
	af(bf.inner, q + 1, g + 1, Q - 2, j - 2, Y.frameIn);
	af(bf.bg, q + 2, g + 2, Q - 4, j - 4, Y.group);
	af(bf.bar, q + 2, g + 2, Q - 4, 2, Y.accent);
	Ff(bf.title, "keybinds", q + 8, (g + 4) + M(((jf.R - jf.th)) / 2), Y.text);
	af(bf.rule, q + 6, (g + jf.R) + 3, Q - 12, 1, Y.border);
	local O = (g + jf.R) + 6;
	for R, A in ipairs(R) do
		local M = nn(R);
		Ff(M.name, Of(A[1], (Q - k) - 26), q + 8, O, A[3] and Y.text or Y.textDim);
		Ff(M.key, A[2], ((q + Q) - 8) - qf(A[2]), O, A[3] and Y.accent or Y.textDim);
		O = O + f;
	end;
	for Y = #R + 1, #bf.rows, 1 do
		Xf(bf.rows[Y].name);
		Xf(bf.rows[Y].key);
	end;
end;
function ff.SetKeybindList(Y, R)
	local f = Af(Y, R);
	if not bf.edge then
		local Y = ff._ov;
		bf.edge = cf(Y, "Square", rf.mark);
		bf.inner = cf(Y, "Square", rf.markIn);
		bf.bg = cf(Y, "Square", rf.markBg);
		bf.bar = cf(Y, "Square", rf.markText);
		bf.rule = cf(Y, "Square", rf.markText);
		bf.title = cf(Y, "Text", rf.markText);
	end;
	bf.visible = f and true or false;
	Vn();
	for Y, R in ipairs(ff._syncToggles.keybinds) do
		if R.win.alive then
			R:Set(bf.visible, true);
		end;
	end;
	return ff;
end;
function ff.SetWatermark(Y, R)
	local f = Af(Y, R);
	if not vn.edge then
		local Y = ff._ov;
		vn.edge = cf(Y, "Square", rf.mark);
		vn.inner = cf(Y, "Square", rf.markIn);
		vn.bg = cf(Y, "Square", rf.markBg);
		vn.bar = cf(Y, "Square", rf.markText);
		vn.text = cf(Y, "Text", rf.markText);
	end;
	if f == nil or f == false then
		vn.visible = false;
	else
		vn.label = tostring(f);
		vn.visible = true;
	end;
	Ln();
	return ff;
end;
function ff.SetWatermarkVisible(Y, R)
	local f = Af(Y, R);
	if not vn.edge then
		ff.SetWatermark(vn.label or "ui");
	end;
	vn.visible = f and true or false;
	Ln();
	for Y, R in ipairs(ff._syncToggles.watermark) do
		if R.win.alive then
			R:Set(vn.visible, true);
		end;
	end;
	return ff;
end;
Kf = function(Y)
		if ff._focus then
			lf();
		end;
		Y.was = {};
		Y.rep = {};
		Y.t0 = T();
		Y.caretOn = true;
		Y.orig = Y.buf;
		for R, f in ipairs(l) do
			Y.was[f[1]] = J(f[1]);
		end;
		for R, f in ipairs(s) do
			Y.was[f] = J(f);
		end;
		ff._focus = Y;
		Mf("textbox", Y.refresh);
		ff:_wake();
	end;
lf = function()
		local Y = ff._focus;
		if not Y then
			return;
		end;
		ff._focus = nil;
		Mf("textbox", Y.commit, Y.buf);
		Mf("textbox", Y.refresh);
	end;
sf = function()
		local Y = ff._focus;
		if not Y then
			return;
		end;
		ff._focus = nil;
		if Y.live and Y.orig ~= Y.buf then
			Mf("textbox", Y.preview, Y.orig);
		end;
		Mf("textbox", Y.refresh);
	end;
local function zn(Y, R)
	local f = ff._focus;
	if not f then
		return false;
	end;
	if f.target == xn then
		local f = xn.g and xn.g.hex;
		return f and c(Y, R, f[1], f[2], f[3], f[4]);
	end;
	local A = f.target;
	return A.placed and (A.boxY and c(Y, R, A.boxX or A.px, A.boxY, A.boxW or A.pw, A.boxH));
end;
local function YP(Y)
	local R = ff._focus;
	local f = J(16);
	local A = J(17);
	local k = false;
	local function M(f)
		local A = J(f);
		local k = R.was[f];
		R.was[f] = A;
		if not A then
			R.rep[f] = nil;
			return false;
		end;
		if not k then
			R.rep[f] = Y + .42;
			return true;
		end;
		if R.rep[f] and Y >= R.rep[f] then
			R.rep[f] = Y + .035;
			return true;
		end;
		return false;
	end;
	for f = 1, #s, 1 do
		local j = s[f];
		if M(j) then
			R.fresh = nil;
			if j == 13 or j == 9 then
				lf();
				return;
			elseif j == 27 then
				sf();
				return;
			elseif j == 8 then
				if R.caret > 0 then
					local Y = 1;
					if A then
						local f = P(R.buf, 1, R.caret);
						local A = f:match("^(.-)%S*%s*$") or "";
						Y = #f - #A;
					end;
					R.buf = P(R.buf, 1, R.caret - Y) .. P(R.buf, R.caret + 1);
					R.caret = R.caret - Y;
					k = true;
				end;
			elseif j == 46 then
				if R.caret < #R.buf then
					R.buf = P(R.buf, 1, R.caret) .. P(R.buf, R.caret + 2);
					k = true;
				end;
			elseif j == 37 then
				R.caret = o(0, R.caret - 1);
			elseif j == 39 then
				R.caret = Q(#R.buf, R.caret + 1);
			elseif j == 36 then
				R.caret = 0;
			elseif j == 35 then
				R.caret = #R.buf;
			end;
			R.t0 = Y;
			R.caretOn = true;
			Mf("textbox", R.refresh);
		end;
	end;
	if A then
		return;
	end;
	for A = 1, #l, 1 do
		local o = l[A];
		if M(o[1]) then
			local A = f and o[3] or o[2];
			local M = true;
			if R.numeric and not A:match("[%d%.%-]") then
				M = false;
			end;
			if R.maxLength and #R.buf >= R.maxLength then
				M = false;
			end;
			if M then
				if R.fresh then
					R.buf, R.caret, R.fresh = "", 0, nil;
				end;
				R.buf = P(R.buf, 1, R.caret) .. (A .. P(R.buf, R.caret + 1));
				R.caret = R.caret + 1;
				k = true;
				R.t0 = Y;
				R.caretOn = true;
			end;
		end;
	end;
	if k then
		if R.live then
			Mf("textbox", R.preview, R.buf);
		end;
		Mf("textbox", R.refresh);
	end;
end;
Bf = function(Y)
		if ff._listen and ff._listen ~= Y then
			If(ff._listen, nil, true);
		end;
		ff._listen = Y;
		ff._listenWas = {};
		for Y, R in ipairs(K) do
			ff._listenWas[R] = J(R);
		end;
		Y:_repaint();
		ff:_wake();
	end;
If = function(Y, R, f)
		if ff._listen ~= Y then
			return;
		end;
		ff._listen = nil;
		if not f then
			Y:Set(R or false);
		end;
		Y:_repaint();
	end;
local function RP()
	local Y = ff._listen;
	local R = ff._listenWas;
	for f = 1, #K, 1 do
		local A = K[f];
		local k = J(A);
		if k and not R[A] then
			if A == 27 then
				If(Y, nil, true);
			elseif A == 8 then
				If(Y, false);
			else
				If(Y, A);
			end;
			return;
		end;
		R[A] = k;
	end;
end;
local function fP(Y)
	if not b.active then
		return true;
	end;
	if not ff._actAt or Y - ff._actAt > .25 then
		ff._actAt = Y;
		local R, f = pcall(isrbxactive);
		ff._act = (not R) or (f and true or false);
	end;
	return ff._act;
end;
local function AP(Y)
	local R = ff._mouse;
	if not R then
		if ff._mouseRetry and Y < ff._mouseRetry then
			return nil;
		end;
		ff._mouseRetry = Y + .5;
		i = i or B("Players");
		local f = i and i.LocalPlayer;
		if f then
			local Y, A = pcall(function()
					return f:GetMouse();
				end);
			if Y and A then
				R = A;
				ff._mouse = A;
				if not ff._wheelHooked then
					ff._wheelHooked = true;
					pcall(function()
						ff._conns[#ff._conns + 1] = A.WheelForward:Connect(function()
								ff._wheel = ff._wheel - 1;
							end);
					end);
					pcall(function()
						ff._conns[#ff._conns + 1] = A.WheelBackward:Connect(function()
								ff._wheel = ff._wheel + 1;
							end);
					end);
				end;
			end;
		end;
		if not R then
			return nil;
		end;
	end;
	local f, A = R.X, R.Y;
	if type(f) ~= "number" or type(A) ~= "number" then
		ff._mouse = nil;
		return nil;
	end;
	local k = ff.Settings.cursorOffset;
	return f + ((k[1] or 0)), A + ((k[2] or 0));
end;
local function kP(Y, R)
	for f = #ff.Windows, 1, -1 do
		local A = ff.Windows[f];
		if A:_contains(Y, R) then
			return A;
		end;
	end;
	return nil;
end;
local function MP(Y, R)
	pf();
	if ff._pick then
		if ln(Y, R) then
			Bn(Y, R);
			return;
		end;
		local f = ff._pick;
		wf();
		local A = f.host or f;
		if A.placed and (c(Y, R, A.px, A.py, A.pw, A:height()) and ((f.inline == false or (f.zx1 and (Y >= f.zx1 - 3 and Y <= f.zx2 + 3))))) then
			return;
		end;
	end;
	if ff._drop then
		if Dn(Y, R) then
			local f = ff._drop;
			local A, k = an.upR, an.dnR;
			if A and c(Y, R, A[1], A[2], A[3], A[4]) then
				Hn(-an.n);
			elseif k and c(Y, R, k[1], k[2], k[3], k[4]) then
				Hn(an.n);
			elseif Y >= (an.x + an.w) - 8 and (an.n < #an.list and Wn(R)) then
				ff._cap = { kind = "dropbar", win = f.win };
			elseif Wn(R) then
				ff._cap = {
						kind = "droprow",
						win = f.win,
						y0 = R,
						first0 = an.first,
					};
			end;
			return;
		end;
		local f = ff._drop;
		df();
		if f.placed and c(Y, R, f.px, f.py, f.pw, jf.R) then
			return;
		end;
	end;
	if ff._focus and not zn(Y, R) then
		lf();
	end;
	if ff._listen then
		local f = ff._listen;
		If(f, nil, true);
		local A = f.host or f;
		if A.placed and c(Y, R, A.px, A.py, A.pw, jf.R) then
			return;
		end;
	end;
	if vn.visible and (vn.rect and c(Y, R, vn.rect[1], vn.rect[2], vn.rect[3], vn.rect[4])) then
		ff._cap = { kind = "mark", dx = Y - vn.rect[1], dy = R - vn.rect[2] };
		return;
	end;
	local f = bf.visible and bf.rect;
	if f and c(Y, R, f[1], f[2], f[3], f[4]) then
		ff._cap = { kind = "klist", dx = Y - f[1], dy = R - f[2] };
		return;
	end;
	local A = kP(Y, R);
	if not A then
		return;
	end;
	if A ~= ff.Windows[#ff.Windows] then
		for Y = #ff.Windows, 1, -1 do
			if ff.Windows[Y] == A then
				E(ff.Windows, Y);
			end;
		end;
		ff.Windows[#ff.Windows + 1] = A;
		Xn();
	end;
	local k = A.titleRect;
	if k and c(Y, R, k[1], k[2], k[3], k[4]) then
		ff._cap = {
				kind = "move",
				win = A,
				dx = Y - A.x,
				dy = R - A.y,
			};
		return;
	end;
	if A.tabRect then
		local f = A.tabRect;
		if c(Y, R, f[1], f[2], f[3], f[4]) then
			for f, k in ipairs(A.tabs) do
				local M = k.hit;
				if k.visible and (M and c(Y, R, M[1], M[2], M[3], M[4])) then
					A:SelectTab(k);
				end;
			end;
			return;
		end;
	end;
	local M = A.gripRect;
	if M and c(Y, R, M[1], M[2], M[3], M[4]) then
		ff._cap = {
				kind = "resize",
				win = A,
				dx = (A.x + A.w) - Y,
				dy = (A.y + A.h) - R,
			};
		return;
	end;
	local Q, j = A:_colAt(Y, R);
	if not Q then
		return;
	end;
	local u = A:_activeTab();
	local P, q = j.upR, j.dnR;
	if P and c(Y, R, P[1], P[2], P[3], P[4]) then
		A:_scrollBy(Q, -((j.vb - j.vt)) * .85);
		return;
	elseif q and c(Y, R, q[1], q[2], q[3], q[4]) then
		A:_scrollBy(Q, ((j.vb - j.vt)) * .85);
		return;
	end;
	local g = j.sb;
	local O = (not ((g and c(Y, R, g[1], g[2], g[3], g[4])))) and A:_groupAt(Q, R) or nil;
	if O then
		O:Toggle();
		return;
	end;
	if g and (u and c(Y, R, g[1], g[2], g[3], g[4])) then
		ff._cap = {
				kind = "sbar",
				win = A,
				c = Q,
				tab = u,
			};
		local Y = j.vb - j.vt;
		local f = o(1, Y - g[5]);
		local k = g[5];
		local M = j.vt + ((Y - k)) * ((u.scroll[Q] / o(1, u.maxScroll[Q])));
		if R >= M and R < M + k then
			ff._cap.grab = R - M;
		else
			ff._cap.grab = k / 2;
		end;
		ff._cap.travel = f;
		A._dirty = true;
		return;
	end;
	local N = A:_rowAt(Q, R);
	if N then
		if N:_enabled() and N.press then
			N:press(Y, R);
		end;
		return;
	end;
	if u then
		ff._cap = {
				kind = "pan",
				win = A,
				c = Q,
				tab = u,
				y0 = R,
				s0 = u.target[Q],
			};
	end;
end;
local function oP(Y, R)
	local f = ff._cap;
	local A = f.kind;
	if A == "move" then
		local A = f.win;
		local k, M = Y - f.dx, R - f.dy;
		if k ~= A.x or M ~= A.y then
			if ff._pick and (ff._pick.win == A and xn.x) then
				xn.x, xn.y = xn.x + ((k - A.x)), xn.y + ((M - A.y));
			end;
			A.x, A.y = k, M;
			A._dirty = true;
		end;
	elseif A == "resize" then
		local A = f.win;
		local k, M = (Y + f.dx) - A.x, (R + f.dy) - A.y;
		k, M = o(A.minW, k), o(A.minH, M);
		if k ~= A.w or M ~= A.h then
			A.w, A.h = k, M;
			A._dirty = true;
		end;
	elseif A == "slider" then
		f.wid:_dragTo(Y);
	elseif A == "sbar" then
		local Y, A, k = f.win, f.c, f.tab;
		local M = Y.cols[A];
		local o = U((((R - f.grab) - M.vt)) / f.travel, 0, 1);
		local Q = o * k.maxScroll[A];
		k.target[A] = Q;
		k.scroll[A] = Q;
		Y:_layoutColumn(k, A);
	elseif A == "pan" then
		local Y = f.tab;
		local A = U(f.s0 - ((R - f.y0)), 0, Y.maxScroll[f.c]);
		Y.target[f.c], Y.scroll[f.c] = A, A;
		f.win:_layoutColumn(Y, f.c);
	elseif A == "sv" or A == "hue" then
		sn(A, Y, R);
	elseif A == "dropbar" then
		local Y = ff._drop;
		if Y then
			local Y = ((an.y + 1) + an.hh) + an.ah;
			local f = U(((R - Y)) / o(1, an.n * an.rh), 0, 1);
			local A = 1 + M(f * o(0, #an.list - an.n) + .5);
			if A ~= an.first then
				an.first = A;
				yf();
			end;
		end;
	elseif A == "mark" then
		vn.x, vn.y = Y - f.dx, R - f.dy;
		Ln();
	elseif A == "klist" then
		bf.x, bf.y = Y - f.dx, R - f.dy;
		Vn();
	elseif A == "droprow" and ff._drop then
		if not f.moved and j(R - f.y0) > 4 then
			f.moved = true;
		end;
		if f.moved then
			local Y = f.first0 - M(((R - f.y0)) / an.rh + .5);
			if Y ~= an.first then
				an.first = Y;
				yf();
			end;
		end;
	end;
end;
local function QP(Y, R)
	local f = ff._cap;
	ff._cap = nil;
	if not f then
		return;
	end;
	local A = f.kind;
	if A == "button" then
		local A = f.wid;
		A.held = false;
		if A.placed and (c(Y, R, A.px, A.py, A.pw, A:height()) and A:_enabled()) then
			A:_click();
		end;
		if A.placed then
			A:paint();
		end;
	elseif A == "slider" then
		local Y = f.wid;
		if Y._pending then
			Y:_fire();
			ff._pending[Y] = nil;
		end;
	elseif A == "sv" or A == "hue" then
		local Y = ff._pick;
		if Y and Y._pending then
			Y:_fire();
			ff._pending[Y] = nil;
		end;
	elseif A == "sbar" then
		f.win._dirty = true;
	elseif A == "droprow" then
		local A = ff._drop;
		if A and (not f.moved and Dn(Y, R)) then
			local Y = Wn(R);
			local f = Y and an.list[(an.first + Y) - 1];
			if f then
				A:_pick(f);
				if A.multi then
					yf();
				else
					df();
				end;
			end;
		end;
	elseif ((A == "move" or A == "resize")) and f.win.configFile then
		f.win._saveAt = T() + .5;
	elseif A == "klist" or A == "mark" then
		for Y, R in ipairs(ff.Windows) do
			if R.configFile then
				R._saveAt = T() + .5;
			end;
		end;
	end;
	ff._hoverDirty = true;
end;
local function jP(Y, R)
	if ff._drop or ff._pick or ff._listen then
		return;
	end;
	local f = kP(Y, R);
	if not f then
		return;
	end;
	local A = f:_colAt(Y, R);
	if not A then
		return;
	end;
	local k = f:_rowAt(A, R);
	if k and (k:_enabled() and k.rpress) then
		k:rpress(Y, R);
	end;
end;
local function uP(Y)
	if Y == ff._hover then
		return;
	end;
	local R = ff._hover;
	ff._hover = Y;
	ff._hoverT = ff._now or T();
	pf();
	if R and (R.placed and R.win.alive) then
		R:paint();
	end;
	if Y and Y.placed then
		Y:paint();
	end;
end;
local function PP(Y, R)
	local f, A, k, M, o = nil, nil, nil, nil, nil;
	local Q, j = false, nil;
	if ff._pick and ln(Y, R) then
		Q, j = true, ff._pick.win;
		local f = xn.g;
		local A = ((f.done and c(Y, R, f.done[1], f.done[2], f.done[3], f.done[4]))) and "done" or nil;
		if A ~= xn.hot then
			xn.hot = A;
			mf();
		end;
	elseif ff._drop and Dn(Y, R) then
		Q, j = true, ff._drop.win;
		local f, A = an.upR, an.dnR;
		if f and c(Y, R, f[1], f[2], f[3], f[4]) then
			M = { kind = "drop", dir = -1 };
		elseif A and c(Y, R, A[1], A[2], A[3], A[4]) then
			M = { kind = "drop", dir = 1 };
		end;
		local k = (not M) and Wn(R) or nil;
		if k ~= an.hover then
			an.hover = k;
			yf();
		end;
	else
		if ff._drop and an.hover then
			an.hover = nil;
			yf();
		end;
		if ff._pick and xn.hot then
			xn.hot = nil;
			mf();
		end;
		local u = bf.visible and bf.rect;
		if (vn.visible and (vn.rect and c(Y, R, vn.rect[1], vn.rect[2], vn.rect[3], vn.rect[4]))) or (u and c(Y, R, u[1], u[2], u[3], u[4])) then
			Q = true;
		else
			local u = kP(Y, R);
			if u then
				Q, j = true, u;
				A = u;
				local P = u.tabRect;
				if P and c(Y, R, P[1], P[2], P[3], P[4]) then
					for f, A in ipairs(u.tabs) do
						local M = A.hit;
						if A.visible and (M and c(Y, R, M[1], M[2], M[3], M[4])) then
							k = A;
						end;
					end;
				else
					local A, k = u:_colAt(Y, R);
					if A then
						local Q, j = k.upR, k.dnR;
						if Q and c(Y, R, Q[1], Q[2], Q[3], Q[4]) then
							M = {
									kind = "col",
									win = u,
									c = A,
									dir = -1,
								};
						elseif j and c(Y, R, j[1], j[2], j[3], j[4]) then
							M = {
									kind = "col",
									win = u,
									c = A,
									dir = 1,
								};
						else
							o = u:_groupAt(A, R);
							if not o then
								f = u:_rowAt(A, R);
							end;
						end;
					end;
				end;
			end;
		end;
	end;
	local u = ff._cap;
	if u then
		if u.kind == "slider" then
			f = u.wid;
		elseif u.kind == "button" then
			f = (f == u.wid) and f or nil;
		end;
	end;
	uP(f);
	if o ~= ff._hoverGroup then
		local Y = ff._hoverGroup;
		ff._hoverGroup = o;
		if Y then
			Y:_repaintHeader();
		end;
		if o then
			o:_repaintHeader();
		end;
	end;
	local P = ff._arrow;
	local q = (P == nil and M == nil) or (P and (M and (P.kind == M.kind and (P.win == M.win and (P.c == M.c and P.dir == M.dir)))));
	if not q then
		ff._arrow = M;
		if M then
			M.t0 = ff._now or T();
		end;
		for Y, R in ipairs({ P or false, M or false }) do
			if R and R.kind == "col" then
				if R.win.alive and (R.win._laidOut and R.win.cols[R.c].upR) then
					R.win:_paintArrows(R.c);
				end;
			elseif R and ff._drop then
				yf();
			end;
		end;
	end;
	for Y, R in ipairs(ff.Windows) do
		local f = (R == A) and k or nil;
		if R._tabHover ~= f then
			R._tabHover = f;
			if R._laidOut and not R._dirty then
				R:_paintTabs();
			end;
		end;
	end;
	ff._overUI = Q;
	ff._overWin = j;
	ff._hoverWin = A;
end;
local function qP(Y)
	if not Y then
		return true;
	end;
	local R = Y.captureInput;
	if R == nil or R == true then
		return true;
	end;
	if R == false then
		return false;
	end;
	local f, A = pcall(R);
	return (not f) or (A and true or false);
end;
local function gP()
	local Y = ff._focus;
	if Y then
		local R = Y.target;
		return qP(R == xn and ((ff._pick and ff._pick.win)) or R.win);
	end;
	if ff._listen then
		return qP(ff._listen.win);
	end;
	if ff._drop and an.search then
		return qP(ff._drop.win);
	end;
	local R = ff._cap;
	if R then
		return qP(R.win or (R.wid and R.wid.win));
	end;
	if ff._overUI then
		return qP(ff._overWin);
	end;
	return false;
end;
local function OP(Y)
	if not b.input then
		return;
	end;
	local R = true;
	if ff.Settings.captureInput and not ff._dead then
		R = not gP();
	end;
	if Y or ff._inputSent ~= R then
		if ff._inputSent == nil and (R and not Y) then
			return;
		end;
		ff._inputSent = R;
		pcall(setrobloxinput, R);
	end;
end;
local NP, EP = {}, {};
local function TP(Y, R)
	local f = J(Y);
	local A = NP[Y];
	NP[Y] = f;
	if not f then
		EP[Y] = nil;
		return false;
	end;
	if not A then
		EP[Y] = R + .35;
		return true;
	end;
	if EP[Y] and R >= EP[Y] then
		EP[Y] = R + .05;
		return true;
	end;
	return false;
end;
function an.type(Y)
	local R = ff._drop;
	local f = J(16);
	local A = an.was;
	local k = false;
	for Y = 1, #l, 1 do
		local R = l[Y];
		local M = J(R[1]);
		if M and (not A[R[1]] and #an.query < 24) then
			an.query = an.query .. ((f and R[3] or R[2]));
			k = true;
		end;
		A[R[1]] = M;
	end;
	local M, o, Q = TP(8, Y), TP(27, Y), TP(13, Y);
	local j, u, q, g = TP(38, Y), TP(40, Y), TP(33, Y), TP(34, Y);
	if o then
		df();
		return;
	end;
	if M and #an.query > 0 then
		an.query = P(an.query, 1, -2);
		k = true;
	end;
	if k then
		an.first = 1;
		an.hover = nil;
		yf();
	end;
	if Q and an.list[an.first] then
		R:_pick(an.list[an.first]);
		if R.multi then
			yf();
		else
			df();
			return;
		end;
	end;
	if j or q then
		Hn(q and -an.n or -1);
	elseif u or g then
		Hn(g and an.n or 1);
	end;
end;
local function SP(Y)
	if not b.key then
		return;
	end;
	if ff._listen then
		RP();
		return;
	end;
	if ff._focus then
		YP(Y);
		return;
	end;
	if ff._drop and an.search then
		an.type(Y);
		return;
	end;
	local R = ff._binds;
	for Y = 1, #R, 1 do
		local f = R[Y];
		local A = f.vk;
		if A and f.win.alive then
			local Y = J(A);
			if Y ~= f.down then
				f.down = Y;
				if f:_enabled() then
					f:_edge(Y);
				end;
			end;
		end;
	end;
	for Y, R in ipairs(ff.Windows) do
		if R.toggleKey and not R._menuBindOwned then
			local Y = J(R.toggleKey);
			if Y ~= R._keyWas then
				R._keyWas = Y;
				if Y then
					R:Toggle();
				end;
			end;
		end;
	end;
	local f = ff._drop and Dn(ff._mx, ff._my);
	local A = ff._hoverWin;
	local k = ff._hover and (ff._hover.kind == "slider" and ff._hover) or nil;
	if not ((f or A or k)) then
		return;
	end;
	local M, o = TP(38, Y), TP(40, Y);
	local Q, j = TP(33, Y), TP(34, Y);
	local u, P = TP(37, Y), TP(39, Y);
	if f then
		if M or Q then
			Hn(Q and -an.n or -1);
		elseif o or j then
			Hn(j and an.n or 1);
		end;
		return;
	end;
	if k and k:_enabled() then
		if u then
			k:nudge(-1);
		elseif P then
			k:nudge(1);
		end;
	end;
	if A and ((M or o or Q or j)) then
		local Y, R = A:_colAt(ff._mx, ff._my);
		if Y then
			local f = ((Q or j)) and R.h * .8 or jf.R * 2;
			A:_scrollBy(Y, ((M or Q)) and -f or f);
		end;
	end;
end;
local function rP(Y)
	if next(ff._rainbow) == nil then
		return;
	end;
	local R = ((Y * ff.Settings.rainbowSpeed)) % 1;
	for Y in pairs(ff._rainbow) do
		if Y.win.alive then
			Y:_setHSV(R, Y.s > 0 and Y.s or 1, Y.v > 0 and Y.v or 1);
		else
			ff._rainbow[Y] = nil;
		end;
	end;
end;
local function UP(Y, R)
	for f in pairs(ff._pending) do
		if not f.win.alive then
			ff._pending[f] = nil;
		elseif f._pending and ((R or Y - ((f._lastFire or 0)) >= .033333333333333)) then
			ff._pending[f] = nil;
			f:_fire();
		elseif not f._pending then
			ff._pending[f] = nil;
		end;
	end;
end;
local function cP(Y)
	if Y < ff._next1 then
		return;
	end;
	ff._next1 = Y + 1;
	if vn.visible then
		Ln();
	end;
	if ff._armed and (ff._armed._armed and Y > ff._armed._armed) then
		local Y = ff._armed;
		ff._armed = nil;
		Y._armed = nil;
		if Y.placed then
			Y:paint();
		end;
	end;
end;
local function XP()
	for Y, R in ipairs(ff.Windows) do
		if R.visible or R.fadeV > 0 then
			return true;
		end;
	end;
	return ff._pick ~= nil or ff._drop ~= nil or #en.active > 0 or ff._focus ~= nil or ff._listen ~= nil or ff._cap ~= nil;
end;
local function aP()
	local Y = ff.Settings.inputGuard;
	if Y then
		local R, f = pcall(Y);
		if R and f then
			return true;
		end;
	end;
	local R = ff.Windows;
	for Y = 1, #R, 1 do
		local f = R[Y].inputGuard;
		if f then
			local Y, R = pcall(f);
			if Y and R then
				return true;
			end;
		end;
	end;
	return false;
end;
local function FP(Y)
	if ff._cap then
		return;
	end;
	local R = ff.Windows;
	for f = 1, #R, 1 do
		local A = R[f];
		if A._saveAt and Y >= A._saveAt then
			A:SaveSettings();
		end;
	end;
end;
local function tP(Y, R)
	ff._now = Y;
	local f = fP(Y);
	local A, k = AP(Y);
	if not A then
		A, k = ff._mx, ff._my;
	end;
	local M, o = false, false;
	if f and not aP() then
		M = b.m1 and (ismouse1pressed() and true) or false;
		o = b.m2 and (ismouse2pressed() and true) or false;
	end;
	local Q = A ~= ff._mx or k ~= ff._my;
	ff._mx, ff._my = A, k;
	if f and Y >= ff._nextKeys then
		ff._nextKeys = Y + .0083333333333333;
		SP(Y);
	end;
	if M and not ff._m1 then
		MP(A, k);
		ff._hoverDirty = true;
	elseif M and ff._cap then
		if Q then
			oP(A, k);
		end;
	elseif not M and ff._m1 then
		QP(A, k);
	end;
	if o and not ff._m2 then
		jP(A, k);
	end;
	ff._m1, ff._m2 = M, o;
	if ff._wheel ~= 0 then
		local Y = ff._wheel;
		ff._wheel = 0;
		if ff._drop and Dn(A, k) then
			Hn(Y);
		else
			local R = kP(A, k);
			if R then
				local f = R:_colAt(A, k);
				if f then
					R:_scrollBy(f, (Y * jf.R) * 3);
				end;
			end;
		end;
	end;
	for f, A in ipairs(ff.Windows) do
		A:_frame(Y, R);
	end;
	if Q or ff._hoverDirty then
		ff._hoverDirty = false;
		PP(A, k);
	end;
	local j = ff._arrow;
	if j and (not ff._cap and (f and Y - j.t0 > .12)) then
		local f = Y - j.t0 > 1;
		if j.kind == "col" then
			if j.win.alive and j.win.fadeV > 0 then
				j.win:_scrollBy(j.c, (j.dir * ((f and 700 or 300))) * R);
			end;
		elseif ff._drop and Y >= ((j.next or 0)) then
			j.next = Y + ((f and .035 or .08));
			Hn(j.dir);
		end;
	end;
	local u = ff._hover;
	if u and (u._tipLines and (not ff._cap and f)) then
		if In.shown == u then
			if Q then
				bn(u, A, k);
			end;
		elseif Y - ((ff._hoverT or Y)) >= ff.Settings.tooltipDelay then
			bn(u, A, k);
		end;
	elseif In.shown then
		pf();
	end;
	local P = ff._focus;
	if P then
		local R = (((Y - P.t0)) % 1) < .55;
		if R ~= P.caretOn then
			P.caretOn = R;
			Mf("textbox", P.refresh);
		end;
	end;
	if ff._flashW and (ff._flashW._flash and Y > ff._flashW._flash) then
		local Y = ff._flashW;
		ff._flashW = nil;
		Y._flash = nil;
		Y:_repaint();
	end;
	if ff.Bar.rainbow and Y >= ff._nextBar then
		ff._nextBar = Y + .05;
		for R, f in ipairs(ff.Windows) do
			if f.fadeV > 0 and f._laidOut then
				f:_paintBar(Y);
			end;
		end;
	end;
	if Y >= ff._next30 then
		ff._next30 = Y + .033333333333333;
		rP(Y);
	end;
	UP(Y, false);
	hn(Y);
	cP(Y);
	FP(Y);
	if bf.dirty then
		Vn();
	end;
	OP(false);
end;
local function DP()
	if ff._dead then
		return;
	end;
	local Y = T();
	if Y < ff._nextFrame then
		return;
	end;
	ff._nextFrame = Y + 1 / ff.Settings.fps;
	local R = Y - ((ff._lastFrame or Y));
	ff._lastFrame = Y;
	if R > .1 then
		R = .1;
	end;
	local f, A = pcall(tP, Y, R);
	if not f then
		kf("ui frame", A);
	end;
	if not XP() then
		ff:_sleep();
	end;
end;
local function WP()
	if ff._dead or ff._rs then
		return;
	end;
	local Y = T();
	if Y < ff._nextIdle then
		return;
	end;
	ff._nextIdle = Y + 1 / ff.Settings.idleHz;
	local R, f = pcall(function()
			ff._now = Y;
			if fP(Y) then
				SP(Y);
			end;
			rP(Y);
			UP(Y, true);
			cP(Y);
			FP(Y);
			if bf.dirty then
				Vn();
			end;
		end);
	if not R then
		kf("ui idle", f);
	end;
end;
function ff._wake(Y)
	if Y._dead or Y._rs or Y._manual then
		return;
	end;
	local R = I and ((I.RenderStepped or I.Heartbeat));
	if not R then
		return;
	end;
	local f, A = pcall(function()
			return R:Connect(DP);
		end);
	if f and A then
		Y._rs = A;
		Y._lastFrame = T();
	end;
end;
function ff._sleep(Y)
	local R = Y._rs;
	Y._rs = nil;
	if R then
		pcall(function()
			R:Disconnect();
		end);
	end;
	ff._overUI = false;
	ff._hoverWin = nil;
	ff._hover = nil;
	ff._arrow = nil;
	OP(false);
end;
function ff.Step(Y)
	local R = T();
	local f = R - ((ff._lastFrame or R));
	ff._lastFrame = R;
	local A, k = pcall(tP, R, Q(f, .1));
	if not A then
		kf("ui frame", k);
	end;
end;
function ff.SetManual(Y, R)
	local f = Af(Y, R);
	ff._manual = f and true or false;
	if ff._manual then
		ff:_sleep();
	else
		ff:_wake();
	end;
	return ff;
end;
local function HP()
	for Y, R in ipairs(ff.Windows) do
		R._dirty = true;
	end;
	if ff._drop then
		yf();
	end;
	if ff._pick then
		mf();
	end;
	if vn.visible then
		Ln();
	end;
	bf.dirty = true;
end;
local function xP()
	for Y, R in pairs(ff._themeWidgets) do
		if R.win.alive and ff.Theme[Y] then
			R:_setRGB(ff.Theme[Y], true);
		end;
	end;
end;
function ff.SetTheme(Y, R)
	local f = Af(Y, R);
	if type(f) == "string" then
		local Y = z[f];
		if not Y then
			return ff;
		end;
		ff.PresetName = f;
		f = Y;
	end;
	if type(f) ~= "table" then
		return ff;
	end;
	for Y, R in ipairs(Yf) do
		local A = f[R] ~= nil and H(f[R]) or nil;
		if A then
			ff.Theme[R] = A;
		end;
	end;
	Qf();
	xP();
	HP();
	return ff;
end;
function ff.SetThemeColor(Y, R, f)
	local A, k;
	if Y == ff then
		A, k = R, f;
	else
		A, k = Y, R;
	end;
	local M = H(k);
	if M and ff.Theme[A] then
		ff.Theme[A] = M;
		Qf();
		HP();
	end;
	return ff;
end;
function ff.GetTheme()
	local Y = {};
	for R, f in ipairs(Yf) do
		Y[f] = D(ff.Theme[f]);
	end;
	return Y;
end;
local function CP()
	local function Y(Y)
		for R = 1, #Y, 1 do
			local f = Y[R];
			if f.t then
				Df(f);
			end;
		end;
	end;
	for R, f in ipairs(ff.Windows) do
		Y(f.nodes);
	end;
	Y(ff._ov);
end;
function ff.SetFont(Y, R, f)
	local A, k;
	if Y == ff then
		A, k = R, f;
	else
		A, k = Y, R;
	end;
	if A ~= nil and G[A] ~= nil then
		ff.FontName = A;
		ff.Font = G[A];
	end;
	if tonumber(k) then
		local Y = ff.TextSize;
		ff.TextSize = U(M(tonumber(k)), 8, 32);
		local R = ff.TextSize / Y;
		if R ~= 1 then
			for Y, f in ipairs(ff.Windows) do
				f.w, f.h = M(f.w * R + .5), M(f.h * R + .5);
				f.minW, f.minH = M(f.minW * R + .5), M(f.minH * R + .5);
			end;
		end;
	end;
	uf();
	CP();
	HP();
	ff:_wake();
	return ff;
end;
ff.FontMetrics = v;
function ff.SetCharRatio(Y, R)
	local f = tonumber(Af(Y, R));
	ff.Settings.charRatio = f and U(f, .2, 1.2) or nil;
	uf();
	HP();
	return ff;
end;
function ff.SetOpacity(Y, R)
	local f = tonumber(Af(Y, R)) or 1;
	ff.Opacity = U(f, .1, 1);
	for Y, R in ipairs(ff.Windows) do
		if R.fadeV > 0 then
			R:_applyAlpha();
		end;
	end;
	return ff;
end;
function ff.SetTextOutline(Y, R)
	local f = Af(Y, R);
	ff.TextOutline = f and true or false;
	CP();
	return ff;
end;
function ff.SetAccentBar(Y, R)
	local f = Af(Y, R);
	if type(f) == "table" then
		for Y, R in pairs(f) do
			ff.Bar[Y] = R;
		end;
	elseif type(f) == "boolean" then
		ff.Bar.rainbow = f;
	end;
	for Y, R in ipairs(ff.Windows) do
		if R._laidOut then
			R:_paintBar(ff._now or T());
		end;
	end;
	return ff;
end;
function ff.KeyName(Y, R)
	return d[Af(Y, R)];
end;
function ff.KeyCode(Y, R)
	return m(Af(Y, R));
end;
function ff.OnUnload(Y, R)
	ff._onUnload[#ff._onUnload + 1] = Af(Y, R);
	return ff;
end;
function ff.Unload(Y)
	if ff._dead then
		return;
	end;
	ff._dead = true;
	if rawget(_G, "UILib") == ff then
		_G.UILib = nil;
	end;
	if type(getgenv) == "function" then
		pcall(function()
			local Y = getgenv();
			if rawget(Y, "UILib") == ff then
				Y.UILib = nil;
			end;
		end);
	end;
	local R = ff._conns;
	ff._conns = {};
	if ff._rs then
		R[#R + 1] = ff._rs;
		ff._rs = nil;
	end;
	for Y, R in ipairs(R) do
		pcall(function()
			R:Disconnect();
		end);
	end;
	for Y, R in ipairs(ff._onUnload) do
		Mf("unload", R);
	end;
	for Y = #ff.Windows, 1, -1 do
		local R = ff.Windows[Y];
		if R and not R._unloading then
			R._unloading = true;
			Mf("unload", R.onUnload, R);
		end;
	end;
	for Y = #ff.Windows, 1, -1 do
		ff.Windows[Y]:Destroy();
	end;
	local f = ff._ov;
	ff._ov = {};
	Hf(f);
	if b.input and ff._inputSent == false then
		pcall(setrobloxinput, true);
	end;
	ff._inputSent = nil;
end;
function kn._save(Y)
	return Y.value;
end;
function Mn._save(Y)
	return Y.value;
end;
function jn._save(Y)
	return Y.value;
end;
function on._save(Y)
	if Y.multi then
		local R = {};
		for f = 1, #Y.values, 1 do
			if Y.value[Y.values[f]] then
				R[#R + 1] = Y.values[f];
			end;
		end;
		if #R == 0 then
			return "";
		end;
		return R;
	end;
	return Y.value or "";
end;
function on._load(R, Y)
	if Y == "" then
		Y = R.multi and {} or false;
	end;
	R:Set(Y);
end;
function un._save(Y)
	return { hex = Y:GetHex(), rainbow = Y.rainbow and true or false };
end;
function un._load(R, Y)
	if type(Y) == "table" then
		if Y.hex then
			R:Set(Y.hex);
		end;
		R:SetRainbow(Y.rainbow and true or false);
	else
		R:Set(Y);
	end;
end;
function Pn._save(Y)
	return { key = Y.value or "", mode = Y.mode };
end;
function Pn._load(R, Y)
	if type(Y) == "table" then
		R:Set(Y.key ~= "" and Y.key or false);
		if Y.mode then
			R:SetMode(Y.mode);
		end;
	else
		R:Set(Y);
	end;
end;
function ef._load(R, Y)
	R:Set(Y);
end;
local function dP(Y)
	if not b.mkdir then
		return;
	end;
	local R = "";
	for Y in (tostring(Y)):gmatch("[^/\\]+") do
		R = (R == "") and Y or (R .. ("/" .. Y));
		local f = false;
		if b.isdir then
			local Y, A = pcall(isfolder, R);
			f = Y and A;
		end;
		if not f then
			pcall(makefolder, R);
		end;
	end;
end;
local yP = {};
function yP.read(Y)
	if not ((p and b.fs)) then
		return nil, "file access is not available";
	end;
	local R, f = pcall(isfile, Y);
	if not ((R and f)) then
		return nil, "config not found";
	end;
	local A, k = pcall(readfile, Y);
	if not A or type(k) ~= "string" then
		return nil, "could not read the config";
	end;
	local M, o = pcall(function()
			return p:JSONDecode(k);
		end);
	if not M or type(o) ~= "table" then
		return nil, "config is damaged";
	end;
	return o;
end;
function yP.write(Y, R)
	if not ((p and b.fs)) then
		return false, "file access is not available";
	end;
	local f, A = pcall(function()
			return p:JSONEncode(R);
		end);
	if not f or type(A) ~= "string" then
		return false, "could not encode the config";
	end;
	local k, M = pcall(writefile, Y, A);
	if not k then
		return false, tostring(M);
	end;
	return true;
end;
function rn._collect(Y)
	local R = {};
	for Y, f in ipairs(Y.flagOrder) do
		if f._save and f.o.save ~= false then
			R[f.flag] = f:_save();
		end;
	end;
	return R;
end;
function rn._applyFlags(R, Y)
	for R, f in ipairs(R.flagOrder) do
		local A = Y[f.flag];
		if A ~= nil and (f._load and f.o.save ~= false) then
			local Y, R = pcall(f._load, f, A);
			if not Y then
				kf("load " .. tostring(f.flag), R);
			end;
		end;
	end;
end;
function rn.SaveConfig(R, Y)
	Y = cn(Y);
	if Y == "" then
		return false, "enter a config name";
	end;
	dP(R.folder);
	return yP.write(R.folder .. ("/" .. (Y .. ".json")), R:_collect());
end;
function rn.LoadConfig(R, Y)
	Y = cn(Y);
	if Y == "" then
		return false, "pick a config";
	end;
	local f, A = yP.read(R.folder .. ("/" .. (Y .. ".json")));
	if not f then
		return false, A;
	end;
	R:_applyFlags(f);
	return true;
end;
function rn.LoadSettings(Y)
	Y._settingsLoaded = true;
	if not Y.configFile then
		return false;
	end;
	local R = yP.read(Y.configFile);
	if not R then
		return false;
	end;
	Y:_applyFlags(R);
	local f, A = tonumber(R._x), tonumber(R._y);
	if f and A then
		Y.x, Y.y = f, A;
	end;
	local k, M = tonumber(R._w), tonumber(R._h);
	if k and (M and Y.resizable) then
		Y.w, Y.h = k, M;
	end;
	local o = tonumber(R._tab);
	if o and Y.tabs[o] then
		Y.active = Y.tabs[o];
	end;
	if type(R._collapsed) == "string" then
		local f = {};
		for Y in R._collapsed:gmatch("[^|]+") do
			f[Y] = true;
		end;
		for Y, R in ipairs(Y.tabs) do
			for Y, R in ipairs(R.groups) do
				if R.collapsible then
					R.collapsed = f[R:_key()] == true;
				end;
			end;
		end;
	end;
	if tonumber(R._klx) and tonumber(R._kly) then
		bf.x, bf.y, bf.dirty = tonumber(R._klx), tonumber(R._kly), true;
	end;
	if tonumber(R._wmx) and tonumber(R._wmy) then
		vn.x, vn.y = tonumber(R._wmx), tonumber(R._wmy);
	end;
	Y._dirty = true;
	return true;
end;
function rn.SaveSettings(Y)
	Y._saveAt = nil;
	if not ((Y.configFile and Y._settingsLoaded)) then
		return false;
	end;
	local R = Y:_collect();
	R._x, R._y, R._w, R._h = M(Y.x), M(Y.y), M(Y.w), M(Y.h);
	local f = {};
	for Y, R in ipairs(Y.tabs) do
		for Y, R in ipairs(R.groups) do
			if R.collapsed then
				f[#f + 1] = R:_key();
			end;
		end;
	end;
	R._collapsed = N(f, "|");
	R._klx, R._kly, R._wmx, R._wmy = bf.x, bf.y, vn.x, vn.y;
	for f, A in ipairs(Y.tabs) do
		if A == Y.active then
			R._tab = f;
		end;
	end;
	return yP.write(Y.configFile, R);
end;
function rn.DeleteConfig(R, Y)
	Y = cn(Y);
	if Y == "" or not b.del then
		return false;
	end;
	local f = pcall(delfile, R.folder .. ("/" .. (Y .. ".json")));
	return f;
end;
function rn.ListConfigs(Y)
	local R = {};
	if not b.list then
		return R;
	end;
	local f, A = pcall(listfiles, Y.folder);
	if not f or type(A) ~= "table" then
		return R;
	end;
	for Y, f in ipairs(A) do
		local A = (tostring(f)):match("([^/\\]+)%.json$");
		if A then
			R[#R + 1] = A;
		end;
	end;
	O(R);
	return R;
end;
function rn.SetAutoload(R, Y)
	if not b.fs then
		return false;
	end;
	dP(R.folder);
	local f = pcall(writefile, R.folder .. "/autoload.txt", Y and cn(Y) or "");
	return f;
end;
function rn.GetAutoload(Y)
	if not b.fs then
		return nil;
	end;
	local R = Y.folder .. "/autoload.txt";
	local f, A = pcall(isfile, R);
	if not ((f and A)) then
		return nil;
	end;
	local k, M = pcall(readfile, R);
	if k and type(M) == "string" then
		M = cn(M);
		if M ~= "" then
			return M;
		end;
	end;
	return nil;
end;
function rn.AddSettingsTab(f, Y, R)
	local A = f;
	local k = f:AddTab(Y or "settings");
	local o = f.columns;
	local Q = k:AddGroup("interface", 1);
	Q:AddDropdown({
		text = "preset",
		flag = "__preset",
		values = V,
		default = ff.PresetName,
		callback = function(Y)
			ff:SetTheme(Y);
		end,
	});
	Q:AddSlider({
		text = "opacity",
		flag = "__opacity",
		min = 30,
		max = 100,
		default = M(ff.Opacity * 100),
		suffix = "%",
		callback = function(Y)
			ff:SetOpacity(Y / 100);
		end,
	});
	Q:AddToggle({
		text = "text outline",
		flag = "__outline",
		default = ff.TextOutline,
		callback = function(Y)
			ff:SetTextOutline(Y);
		end,
	});
	if #e > 0 then
		Q:AddDropdown({
			text = "font",
			flag = "__font",
			values = e,
			default = ff.FontName,
			callback = function(Y)
				ff:SetFont(Y);
			end,
		});
	end;
	Q:AddSlider({
		text = "font size",
		flag = "__fontsize",
		min = 10,
		max = 20,
		default = ff.TextSize,
		callback = function(Y)
			ff:SetFont(nil, Y);
		end,
	});
	local j = ff._syncToggles;
	j.watermark[#j.watermark + 1] = Q:AddToggle({
			text = "watermark",
			flag = "__watermark",
			default = vn.visible,
			callback = function(Y)
				ff:SetWatermarkVisible(Y);
			end,
		});
	Q:AddToggle({
		text = "keybind alerts",
		flag = "__bindtoasts",
		default = ff.Settings.bindToasts,
		tooltip = "a short notification whenever a keybind turns something on or off",
		callback = function(Y)
			ff.Settings.bindToasts = Y;
		end,
	});
	j.keybinds[#j.keybinds + 1] = Q:AddToggle({
			text = "keybind list",
			flag = "__keybinds",
			default = bf.visible,
			callback = function(Y)
				ff:SetKeybindList(Y);
			end,
		});
	Q:AddToggle({
		text = "block game input",
		flag = "__capture",
		default = ff.Settings.captureInput,
		tooltip = "keeps clicks on the menu from also reaching the game",
		callback = function(Y)
			ff.Settings.captureInput = Y;
			OP(true);
		end,
	});
	local u = k:AddGroup("theme colors", 1);
	for Y, R in ipairs(Yf) do
		ff._themeWidgets[R] = u:AddColor({
				text = Rf[R],
				flag = "__c_" .. R,
				default = ff.Theme[R],
				callback = function(Y, f)
					ff:SetThemeColor(R, f.rgb);
				end,
			});
	end;
	local P = k:AddGroup("accent bar", 1);
	P:AddToggle({
		text = "rgb gradient",
		flag = "__bar_rgb",
		default = ff.Bar.rainbow,
		callback = function(Y)
			ff:SetAccentBar({ rainbow = Y });
		end,
	});
	P:AddDropdown({
		text = "direction",
		flag = "__bar_dir",
		values = { "left", "right" },
		default = ff.Bar.direction < 0 and "left" or "right",
		callback = function(Y)
			ff:SetAccentBar({ direction = (Y == "left") and -1 or 1 });
		end,
	});
	P:AddSlider({
		text = "speed",
		flag = "__bar_speed",
		min = 0,
		max = 1,
		step = .02,
		default = ff.Bar.speed,
		suffix = "x",
		callback = function(Y)
			ff:SetAccentBar({ speed = Y });
		end,
	});
	local q = k:AddGroup("configuration", o);
	local g = q:AddTextbox({
			text = "config name",
			default = "default",
			placeholder = "name",
			save = false,
		});
	local O = q:AddDropdown({
			text = "config list",
			values = f:ListConfigs(),
			allowNone = true,
			save = false,
		});
	local N;
	local function E()
		O:SetValues(A:ListConfigs());
		if N then
			N:SetText("autoload: " .. ((A:GetAutoload() or "none")));
		end;
	end;
	q:AddButton({ text = "save", callback = function()
			local Y = g.value;
			local R, f = A:SaveConfig(Y);
			ff:Notify(R and ("saved config " .. cn(Y)) or ("save failed: " .. tostring(f)), 3);
			E();
			if R then
				O:Set(cn(Y), true);
			end;
		end });
	q:AddButton({ text = "load", callback = function()
			local Y = O.value or "";
			if Y == "" or Y == false then
				Y = g.value;
			end;
			local R, f = A:LoadConfig(Y);
			ff:Notify(R and ("loaded config " .. cn(Y)) or ("load failed: " .. tostring(f)), 3);
		end });
	q:AddButton({ text = "delete", confirm = true, callback = function()
			local Y = O.value;
			if Y and Y ~= "" then
				A:DeleteConfig(Y);
				ff:Notify("deleted config " .. Y, 3);
				E();
			end;
		end });
	q:AddButton({ text = "refresh list", callback = E });
	q:AddButton({ text = "set autoload", callback = function()
			local Y = O.value;
			if not Y or Y == "" then
				Y = g.value;
			end;
			A:SetAutoload(Y);
			E();
		end });
	N = q:AddLabel({ text = "autoload: " .. ((f:GetAutoload() or "none")), dim = true });
	local T = k:AddGroup("menu", o);
	T:AddKeybind({
		text = "menu key",
		flag = "__menukey",
		default = f.toggleKey,
		list = false,
		notify = false,
		onClick = function()
			A:Toggle();
		end,
	});
	f._menuBindOwned = true;
	T:AddSlider({
		text = "refresh rate",
		flag = "__fps",
		min = 30,
		max = 240,
		step = 10,
		default = ff.Settings.fps,
		suffix = " fps",
		callback = function(Y)
			ff.Settings.fps = Y;
		end,
	});
	T:AddToggle({
		text = "smooth scrolling",
		flag = "__smooth",
		default = ff.Settings.smoothScroll,
		callback = function(Y)
			ff.Settings.smoothScroll = Y;
		end,
	});
	T:AddButton({ text = "reset theme", callback = function()
			ff:SetTheme("monochrome");
			A:SetValue("__preset", "monochrome");
		end });
	if not ((type(R) == "table" and R.unload == false)) then
		T:AddButton({ text = "unload", confirm = true, callback = function()
				A:Unload();
			end });
	end;
	return k;
end;
ff.Widget = ef;
ff._internals = {
		CP = xn,
		DL = an,
		TT = In,
		M = jf,
		WM = vn,
		KL = bf,
		paintDrop = yf,
	};
ff.Window = rn;
ff.Tab = Sn;
ff.Group = Nn;
if I then
	local Y = I.Heartbeat;
	if Y then
		local R, f = pcall(function()
				return Y:Connect(WP);
			end);
		if R and f then
			ff._conns[#ff._conns + 1] = f;
		end;
	end;
end;
_G.UILib = ff;
if type(getgenv) == "function" then
	pcall(function()
		(getgenv()).UILib = ff;
	end);
end;
return ff;
