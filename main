local of = { 0, 0, 0 };
local function Qf()
	local Y = ff.Theme;
	local R = {};
	R.accent = a(Y.accent);
	R.bg = a(Y.background);
	R.group = a(Y.group);
	R.topbar = a(Y.topbar);
	R.border = a(Y.border);
	R.outline = a(Y.outline);
	R.outlineHi = a(X(Y.outline, Y.text, .22));
	R.text = a(Y.text);
	R.textDim = a(X(Y.text, Y.group, .42));
	R.textOff = a(X(Y.text, Y.group, .66));
	R.header = a(X(Y.text, Y.group, .24));
	R.hover = a(X(Y.group, Y.text, .06));
	local function f(Y)
		Y = Y / 255;
		return Y <= .03928 and Y / 12.92 or ((((Y + .055)) / 1.055)) ^ 2.4;
	end;
	local function A(Y)
		return (f(Y[1]) * .2126 + f(Y[2]) * .7152) + f(Y[3]) * .0722;
	end;
	local function M(Y, R)
		local f, k = A(Y), A(R);
		return ((o(f, k) + .05)) / ((Q(f, k) + .05));
	end;
	local function j(Y, R)
		if M(R, Y) >= 3 then
			return R;
		end;
		return A(Y) > .45 and { 18, 18, 20 } or { 236, 236, 240 };
	end;
	local u = j(Y.topbar, Y.text);
	R.topText = a(u);
	R.topDim = a(X(u, Y.topbar, .42));
	R.topAccent = M(Y.accent, Y.topbar) >= 3 and a(Y.accent) or R.topText;
	local P = X(Y.group, of, A(Y.group) > .5 and .14 or .5);
	R.control = a(P);
	R.controlHi = a(X(Y.group, Y.text, .1));
	R.press = a(X(Y.group, Y.accent, .28));
	R.accentDim = a(X(Y.accent, Y.group, .55));
	R.frameIn = a(X(Y.background, of, .55));
	R.sep = a(X(Y.topbar, Y.border, .6));
	R.track = a(X(Y.background, of, .25));
	R.black = k(0, 0, 0);
	R.white = k(255, 255, 255);
	local function q(R)
		local f = A(Y.group) > .4 and of or { 255, 255, 255 };
		for A = 0, .8, .1 do
			local k = X(R, f, A);
			if Q(M(k, Y.group), M(k, P)) >= 3 then
				return a(k);
			end;
		end;
		return a(X(R, f, .8));
	end;
	R.red = q({ 232, 72, 72 });
	R.orange = q({ 236, 164, 64 });
	R.blue = q({ 74, 164, 236 });
	R.green = q({ 98, 210, 112 });
	ff.C = R;
end;
Qf();
local jf = {};
local function uf()
	local Y = ff.TextSize;
	local R = v[ff.FontName] or L;
	if ff.Settings.charRatio then
		R = { mono = ff.Settings.charRatio };
	end;
	jf.metric = R;
	jf.em = Y * ((R.sans or 1));
	jf.cw = R.mono and Y * R.mono or jf.em * .56;
	jf.th = Y;
	jf.twCache, jf.twCount = {}, 0;
	local f = Y / 13;
	jf.k = f;
	local function A(Y)
		return o(1, M(Y * f + .5));
	end;
	jf.R = o(jf.th + 4, M(Y * 1.55 + .5));
	jf.ty = M(((jf.R - jf.th)) / 2);
	jf.cb = o(8, M(jf.R * .55 + .5));
	jf.bar = o(6, M(Y * .75 + .5));
	jf.pad = A(8);
	jf.gpad = A(8);
	jf.title = jf.R + A(4);
	jf.tabs = jf.R + A(4);
	jf.colGap = A(8);
	jf.gutter = A(7);
	jf.sbw = A(3);
	jf.half = M(jf.th / 2);
	jf.gtop = jf.half + A(3);
	jf.gbot = A(4);
	jf.ggap = A(10);
	jf.arrowH = A(11);
	jf.dash = A(6);
	jf.titleX = A(10);
end;
uf();
local function Pf(Y)
	if jf.metric.mono then
		return #Y * jf.cw;
	end;
	local R = 0;
	for f = 1, #Y, 1 do
		R = R + n[g(Y, f)];
	end;
	return R * jf.em;
end;
local function qf(Y)
	local R = jf.twCache[Y];
	if R then
		return R;
	end;
	R = M(Pf(Y) + .5);
	if jf.twCount > 4000 then
		jf.twCache, jf.twCount = {}, 0;
	end;
	jf.twCache[Y] = R;
	jf.twCount = jf.twCount + 1;
	return R;
end;
local function gf(Y, R)
	local f, A = 0, #Y;
	while f < A do
		local k = M((((f + A) + 1)) / 2);
		if Pf(P(Y, 1, k)) <= R then
			f = k;
		else
			A = k - 1;
		end;
	end;
	return f;
end;
local function Of(Y, R)
	if qf(Y) <= R then
		return Y;
	end;
	local f = gf(Y, R - Pf(".."));
	if f <= 0 then
		return "";
	end;
	return P(Y, 1, f) .. "..";
end;
local function Nf(Y, R)
	local f, A = 0, j(R);
	for k = 1, #Y, 1 do
		local M = j(Pf(P(Y, 1, k)) - R);
		if M < A then
			f, A = k, M;
		end;
	end;
	return f;
end;
local function Ef(Y, R)
	local f = {};
	for Y in ((tostring(Y) .. "\n")):gmatch("(.-)\n") do
		local A = "";
		for Y in Y:gmatch("%S+") do
			if A == "" then
				A = Y;
			elseif Pf(A .. (" " .. Y)) <= R then
				A = A .. (" " .. Y);
			else
				f[#f + 1] = A;
				A = Y;
			end;
		end;
		f[#f + 1] = A;
	end;
	return f;
end;
local function Tf(Y, R)
	local f = {};
	for Y in ((tostring(Y) .. "\n")):gmatch("(.-)\n") do
		local A = "";
		for Y in Y:gmatch("%S+") do
			if A == "" then
				A = Y;
			elseif (#A + 1) + #Y <= R then
				A = A .. (" " .. Y);
			else
				f[#f + 1] = A;
				A = Y;
			end;
		end;
		f[#f + 1] = A;
	end;
	return f;
end;
local Sf = 2000;
local rf = {
		frame = Sf + 1,
		frameIn = Sf + 2,
		bg = Sf + 3,
		chrome = Sf + 4,
		chromeText = Sf + 5,
		gEdge = Sf + 6,
		gFill = Sf + 7,
		gHead = Sf + 8,
		hover = Sf + 8,
		ctl = Sf + 9,
		ctlIn = Sf + 10,
		ctlFill = Sf + 11,
		text = Sf + 12,
		sbar = Sf + 12,
		sthumb = Sf + 13,
		mark = Sf + 2000,
		markIn = Sf + 2001,
		markBg = Sf + 2002,
		markText = Sf + 2003,
		pop = Sf + 2010,
		popIn = Sf + 2011,
		popBg = Sf + 2012,
		popCtl = Sf + 2013,
		popCtlIn = Sf + 2014,
		popFill = Sf + 2015,
		popOver = Sf + 2016,
		popOver2 = Sf + 2017,
		popText = Sf + 2018,
		popTop = Sf + 2019,
		toast = Sf + 2020,
		toastIn = Sf + 2021,
		toastBg = Sf + 2022,
		toastFill = Sf + 2023,
		toastText = Sf + 2024,
		tip = Sf + 2030,
		tipIn = Sf + 2031,
		tipText = Sf + 2032,
	};
local Uf = 20;
local function cf(Y, R, A, k)
	local M = f.new(R);
	local o = {
			d = M,
			v = false,
			bg = k,
			a = 1,
			z = A,
		};
	Y[#Y + 1] = o;
	M.Visible = false;
	M.ZIndex = A + ((Y.zoff or 0));
	if R == "Text" then
		o.t = true;
		M.Size = ff.TextSize;
		o.fs = ff.TextSize;
		if ff.Font ~= nil then
			M.Font = ff.Font;
			o.f = ff.Font;
		end;
		M.Outline = ff.TextOutline;
		o.o = ff.TextOutline;
		M.Center = false;
	else
		M.Filled = true;
	end;
	if k and ff.Opacity ~= 1 then
		M.Transparency = ff.Opacity;
		o.a = ff.Opacity;
	end;
	return o;
end;
local function Xf(Y)
	if Y.v and not Y.dead then
		Y.v = false;
		Y.d.Visible = false;
	end;
end;
local function af(Y, R, f, k, o, Q)
	if Y.dead then
		return;
	end;
	R, f, k, o = M(R + .5), M(f + .5), M(k + .5), M(o + .5);
	if k <= 0 or o <= 0 then
		return Xf(Y);
	end;
	local j = Y.d;
	if Y.x ~= R or Y.y ~= f then
		Y.x, Y.y = R, f;
		j.Position = A(R, f);
	end;
	if Y.w ~= k or Y.h ~= o then
		Y.w, Y.h = k, o;
		j.Size = A(k, o);
	end;
	if Y.c ~= Q then
		Y.c = Q;
		j.Color = Q;
	end;
	if not Y.v then
		Y.v = true;
		j.Visible = true;
	end;
end;
local function Ff(Y, R, f, k, o)
	if Y.dead then
		return;
	end;
	if R == "" then
		return Xf(Y);
	end;
	f, k = M(f + .5), M(k + .5);
	local Q = Y.d;
	if Y.s ~= R then
		Y.s = R;
		Q.Text = R;
	end;
	if Y.x ~= f or Y.y ~= k then
		Y.x, Y.y = f, k;
		Q.Position = A(f, k);
	end;
	if Y.c ~= o then
		Y.c = o;
		Q.Color = o;
	end;
	if not Y.v then
		Y.v = true;
		Q.Visible = true;
	end;
end;
local function tf(Y, R)
	if Y.a ~= R and not Y.dead then
		Y.a = R;
		Y.d.Transparency = R;
	end;
end;
local function Df(Y)
	if Y.dead or not Y.t then
		return;
	end;
	local R = Y.d;
	if Y.fs ~= ff.TextSize then
		Y.fs = ff.TextSize;
		R.Size = ff.TextSize;
	end;
	if ff.Font ~= nil and Y.f ~= ff.Font then
		Y.f = ff.Font;
		R.Font = ff.Font;
	end;
	if Y.o ~= ff.TextOutline then
		Y.o = ff.TextOutline;
		R.Outline = ff.TextOutline;
	end;
end;
local function Wf(Y)
	for R = 1, #Y, 1 do
		Xf(Y[R]);
	end;
end;
local function Hf(Y)
	for R = 1, #Y, 1 do
		Y[R].dead = true;
	end;
	for R = 1, #Y, 1 do
		local f = Y[R].d;
		pcall(function()
			f.Visible = false;
			f:Remove();
		end);
	end;
end;
local xf = {};
function xf.paint(Y, R, f, A, k, o, Q, j)
	local u = ff.C;
	af(Y, f, A, k, o, j == "hot" and u.hover or u.group);
	local P = (j == "hot" and u.accent) or (j == "on" and u.text) or u.textOff;
	local q = f + M(k / 2);
	local g = A + M(((o - 4)) / 2);
	for Y = 1, 4, 1 do
		local f = Q and (Y * 2 - 1) or (9 - Y * 2);
		af(R[Y], q - M(f / 2), (g + Y) - 1, f, 1, P);
	end;
end;
function xf.hide(Y, R)
	Xf(Y);
	for Y = 1, 4, 1 do
		Xf(R[Y]);
	end;
end;
function xf.state(Y, R, f, A, k)
	if not k then
		return "off";
	end;
	local M = ff._arrow;
	if M and (M.kind == Y and (M.win == R and (M.c == f and M.dir == A))) then
		return "hot";
	end;
	return "on";
end;
local Cf, df, yf;
local Zf, wf, mf;
local Kf, lf, sf;
local Bf, If;
local pf;
local bf = { visible = false };
local Jf;
local ef = {};
ef.__index = ef;
local function Gf()
	local Y = setmetatable({}, { __index = ef });
	Y.__index = Y;
	return Y;
end;
local hf = { ["!"] = { text = "[!]", color = "red", title = "risky" }, ["?"] = { text = "[?]", color = "orange", title = "info" }, p = { text = "[p]", color = "blue", title = "permission" } };
local function vf(Y)
	local R = Y._badge;
	if not R then
		return ff.C.accent;
	end;
	if type(R.color) == "string" then
		return ff.C[R.color] or ff.C.accent;
	end;
	return R.color or ff.C.accent;
end;
local function Lf(Y, R)
	Y.tooltip = R;
	Y._tipTitle, Y._tipLines = nil, nil;
	if R == nil or R == false then
		return;
	end;
	local f, A;
	if type(R) == "table" then
		f, A = R.title, R.text;
	else
		A = R;
	end;
	if f == nil and (Y._badge and Y._badge.title) then
		f = "[" .. (Y._badge.title .. "]");
	end;
	Y._tipTitle = f and tostring(f) or nil;
	Y._tipLines = A and Tf(tostring(A), 40) or {};
	if not Y._tipTitle and #Y._tipLines == 0 then
		Y._tipLines = nil;
	end;
end;
local function nf(Y, R, f, A)
	local k = cf(Y.win.nodes, R, f, A);
	Y.nodes[#Y.nodes + 1] = k;
	if Y.host then
		Y.host.nodes[#Y.host.nodes + 1] = k;
	end;
	return k;
end;
local function Vf(Y, R, f, A, k)
	if type(f) ~= "table" then
		f = { text = f };
	end;
	local M = Y.win;
	local o = setmetatable({
			kind = R,
			win = M,
			o = f,
			text = tostring(f.text or f.name or f.title or ""),
			flag = f.flag or f.Flag,
			callback = f.callback or f.Callback,
			enabled = f.enabled ~= false and f.disabled ~= true,
			depOk = true,
			visible = f.visible ~= false,
			hideDisabled = f.hideDisabled,
			nodes = {},
			listeners = {},
			host = k,
			inline = k ~= nil,
		}, A);
	if f.badge then
		if type(f.badge) == "table" then
			o._badge = { text = tostring(f.badge.text or "[*]"), color = f.badge.color, title = f.badge.title };
		else
			o._badge = hf[f.badge] or { text = "[" .. (tostring(f.badge) .. "]"), color = "accent" };
		end;
	end;
	Lf(o, f.tooltip or f.Tooltip);
	if k then
		o.group = k.group;
		k.addons[#k.addons + 1] = o;
	else
		o.group = Y;
		Y.widgets[#Y.widgets + 1] = o;
	end;
	M.widgets[#M.widgets + 1] = o;
	if o.flag then
		M:_registerFlag(o);
	end;
	if f.depends ~= nil then
		o.depends = f.depends;
		M.depWidgets[#M.depWidgets + 1] = o;
		M._depsDirty = true;
	end;
	M._dirty = true;
	return o;
end;
function ef._enabled(Y)
	if Y.host then
		return Y.enabled and (Y.depOk and Y.host:_enabled());
	end;
	return Y.enabled and Y.depOk;
end;
function ef._shown(Y)
	return Y.visible and ((Y.depOk or not Y.hideDisabled));
end;
function ef.hideNodes(Y)
	Y.placed = false;
	Wf(Y.nodes);
	if Y.addons then
		for R = 1, #Y.addons, 1 do
			Y.addons[R].placed = false;
		end;
	end;
end;
function ef.Get(Y)
	return Y.value;
end;
function ef._equal(R, Y)
	return Y == R.value;
end;
function ef._repaint(Y)
	if Y.host then
		if Y.host.placed then
			Y.host:paint();
		end;
	elseif Y.placed then
		Y:paint();
	end;
end;
function ef._apply(R, Y)
	R.value = Y;
	R:_repaint();
	R.win:_changed(R);
end;
function ef._fire(Y)
	Y._pending = nil;
	Y._lastFire = T();
	local R = Y:_cbValue();
	Mf(Y.text ~= "" and Y.text or Y.kind, Y.callback, R, Y);
	for f = 1, #Y.listeners, 1 do
		Mf(Y.text ~= "" and Y.text or Y.kind, Y.listeners[f], R, Y);
	end;
	local f = Y.win;
	if #f.depWidgets > 0 and (not f._inDeps and f.alive) then
		f:_evalDeps();
	end;
end;
function ef._fireSoon(Y)
	Y._pending = true;
	ff._pending[Y] = true;
end;
function ef._cbValue(Y)
	return Y.value;
end;
function ef.Set(f, Y, R)
	if f._coerce then
		Y = f:_coerce(Y);
	end;
	if Y == nil or f:_equal(Y) then
		return f;
	end;
	f:_apply(Y);
	if not R then
		f:_fire();
	end;
	return f;
end;
function ef.SetValue(f, Y, R)
	return f:Set(Y, R);
end;
function ef.GetValue(Y)
	return Y:Get();
end;
function ef.OnChanged(R, Y)
	R.listeners[#R.listeners + 1] = Y;
	return R;
end;
function ef.SetText(R, Y)
	R.text = tostring(Y or "");
	R:_repaint();
	return R;
end;
function ef.SetVisible(R, Y)
	Y = Y and true or false;
	if Y ~= R.visible then
		R.visible = Y;
		if not Y then
			R:hideNodes();
		end;
		R.win._dirty = true;
	end;
	return R;
end;
function ef.SetEnabled(R, Y)
	Y = Y and true or false;
	if Y ~= R.enabled then
		R.enabled = Y;
		R:_repaint();
	end;
	return R;
end;
function ef.SetTooltip(R, Y)
	Lf(R, Y);
	return R;
end;
function ef.height(Y)
	return jf.R;
end;
local function zf(Y, R)
	if ff._hover == Y and (Y:_enabled() and Y.placed) then
		af(Y.n.hover, Y.px, Y.py, Y.pw, R, ff.C.hover);
	else
		Xf(Y.n.hover);
	end;
end;
local function Yn(Y, R, f)
	local A = Y.n.badge;
	if A then
		Ff(A, Y._badge.text, R, f, Y:_enabled() and vf(Y) or ff.C.textOff);
	end;
end;
local function Rn(Y)
	return Y:_enabled() and ff.C.text or ff.C.textOff;
end;
local function fn(Y, R, f)
	local A = Y.addons;
	if not A then
		return R;
	end;
	for Y = #A, 1, -1 do
		local k = A[Y];
		if k.visible then
			R = k:paintInline(R, f) - 6;
		else
			k:hideNodes();
		end;
	end;
	return R;
end;
local function An(Y, R)
	local f = Y.addons;
	if not f then
		return nil;
	end;
	for Y = 1, #f, 1 do
		local A = f[Y];
		if A.placed and (A.zx1 and (R >= A.zx1 - 3 and R <= A.zx2 + 3)) then
			return A;
		end;
	end;
	return nil;
end;
local kn = Gf();
function kn._coerce(R, Y)
	return Y and true or false;
end;
function kn.paint(Y)
	local R, f = Y.n, ff.C;
	local A, k, o = Y.px, Y.py, Y.pw;
	local Q = Y:_enabled();
	zf(Y, jf.R);
	local j = A + jf.gpad;
	Ff(R.label, Y.text, j, k + jf.ty, Rn(Y));
	Yn(Y, (j + qf(Y.text)) + M(jf.cw), k + jf.ty);
	local u = jf.cb;
	local P, q = ((A + o) - jf.gpad) - u, k + M(((jf.R - u)) / 2);
	af(R.box, P, q, u, u, ((Y.value and Q)) and f.outlineHi or f.outline);
	af(R.boxIn, P + 1, q + 1, u - 2, u - 2, f.control);
	if Y.value then
		af(R.fill, P + 2, q + 2, u - 4, u - 4, Q and f.accent or f.accentDim);
	else
		Xf(R.fill);
	end;
	fn(Y, P - 6, k);
end;
function kn.press(R, Y)
	local f = An(R, Y);
	if f then
		if f:_enabled() then
			f:press(Y);
		end;
		return;
	end;
	R:Set(not R.value);
end;
function kn.rpress(R, Y)
	local f = An(R, Y);
	if f and f.rpress then
		f:rpress(Y);
	end;
end;
local Mn = Gf();
function Mn._coerce(R, Y)
	Y = tonumber(Y);
	if not Y then
		return nil;
	end;
	local f, A, k = R.min, R.max, R.step;
	Y = U(Y, f, A);
	if k > 0 then
		Y = f + M(((Y - f)) / k + .5) * k;
		Y = U(Y, f, A);
	end;
	return tonumber(u("%." .. (R.decimals .. "f"), Y));
end;
function Mn._display(Y)
	if Y.format then
		local R, f = pcall(Y.format, Y.value);
		if R and f ~= nil then
			return tostring(f);
		end;
	end;
	return u("%." .. (Y.decimals .. "f"), Y.value) .. Y.suffix;
end;
function Mn.height(Y)
	return (jf.R + jf.bar) + 4;
end;
function Mn.paint(Y)
	local R, f = Y.n, ff.C;
	local A, k, Q = Y.px, Y.py, Y.pw;
	local j = Y:_enabled();
	zf(Y, Y:height());
	local u = A + jf.gpad;
	Ff(R.label, Y.text, u, k + jf.ty, Rn(Y));
	Yn(Y, (u + qf(Y.text)) + M(jf.cw), k + jf.ty);
	local q = ff._focus;
	local g = q and q.target == Y;
	local O = g and q.buf or Y:_display();
	local N = ((A + Q) - jf.gpad) - qf(O);
	Ff(R.val, O, N, k + jf.ty, g and f.text or (j and f.accent or f.textOff));
	if g and q.caretOn then
		af(R.caret, N + M(Pf(P(q.buf, 1, q.caret)) + .5), k + jf.ty, 1, jf.th, f.text);
	else
		Xf(R.caret);
	end;
	local E = o(qf(O), M(jf.cw * 4));
	Y._vx = N;
	Y.boxX, Y.boxW = (((A + Q) - jf.gpad) - E) - M(jf.cw), (E + M(jf.cw)) + jf.gpad;
	Y.boxY, Y.boxH = k, jf.R - 2;
	local T, S, r, c = A + jf.gpad, (k + jf.R) - 1, Q - jf.gpad * 2, jf.bar;
	af(R.edge, T, S, r, c, g and f.accent or (((ff._hover == Y and j)) and f.outlineHi or f.outline));
	af(R.inner, T + 1, S + 1, r - 2, c - 2, f.control);
	local X = Y.max - Y.min;
	local a = X > 0 and U(((Y.value - Y.min)) / X, 0, 1) or 0;
	local F = M(((r - 4)) * a + .5);
	if F > 0 then
		af(R.fill, T + 2, S + 2, F, c - 4, j and f.accent or f.accentDim);
	else
		Xf(R.fill);
	end;
	Y.bx, Y.bw = T + 2, r - 4;
end;
function Mn._dragTo(R, Y)
	if not R.bw or R.bw <= 0 then
		return;
	end;
	local f = U(((Y - R.bx)) / R.bw, 0, 1);
	local A = R:_coerce(R.min + f * ((R.max - R.min)));
	if A ~= nil and A ~= R.value then
		R:_apply(A);
		R:_fireSoon();
	end;
end;
function Mn._edit(Y)
	local R = u("%." .. (Y.decimals .. "f"), Y.value);
	Kf({
		target = Y,
		buf = R,
		caret = #R,
		fresh = true,
		numeric = true,
		maxLength = 14,
		commit = function(R)
			local f = tonumber(R);
			if f then
				Y:Set(f);
			else
				Y:_repaint();
			end;
		end,
		preview = function()
 
		end,
		refresh = function()
			if Y.placed then
				Y:paint();
			end;
		end,
	});
end;
function Mn.press(f, Y, R)
	local A = ff._focus;
	if A and A.target == f then
		A.caret = Q(#A.buf, Nf(A.buf, Y - ((f._vx or Y))));
		A.t0, A.caretOn = T(), true;
		if f.placed then
			f:paint();
		end;
		return;
	end;
	if R and (f.boxY and c(Y, R, f.boxX, f.boxY, f.boxW, f.boxH)) then
		f:_edit();
		return;
	end;
	ff._cap = { kind = "slider", wid = f };
	f:_dragTo(Y);
end;
function Mn.nudge(R, Y)
	local f = R.step > 0 and R.step or ((R.max - R.min)) / 100;
	R:Set(R.value + Y * f);
end;
local on = Gf();
function on._isSelected(R, Y)
	if R.multi then
		return R.value[Y] == true;
	end;
	return R.value == Y;
end;
function on._has(R, Y)
	for f = 1, #R.values, 1 do
		if R.values[f] == Y then
			return true;
		end;
	end;
	return false;
end;
function on._coerce(R, Y)
	if R.multi then
		local f = {};
		if type(Y) == "table" then
			for Y, A in pairs(Y) do
				if type(Y) == "number" then
					if R:_has(A) then
						f[A] = true;
					end;
				elseif A and R:_has(Y) then
					f[Y] = true;
				end;
			end;
		elseif Y ~= nil and R:_has(Y) then
			f[Y] = true;
		end;
		return f;
	end;
	if Y == nil or Y == false then
		return R.allowNone and false or nil;
	end;
	Y = tostring(Y);
	if R:_has(Y) then
		return Y;
	end;
	return nil;
end;
function on._equal(R, Y)
	if R.multi then
		for Y in pairs(Y) do
			if not R.value[Y] then
				return false;
			end;
		end;
		for R in pairs(R.value) do
			if not Y[R] then
				return false;
			end;
		end;
		return true;
	end;
	return Y == R.value;
end;
function on._cbValue(Y)
	if Y.value == false then
		return nil;
	end;
	return Y.value;
end;
function on._display(Y)
	if Y.multi then
		local R = {};
		for f = 1, #Y.values, 1 do
			if Y.value[Y.values[f]] then
				R[#R + 1] = Y.values[f];
			end;
		end;
		return #R > 0 and N(R, ", ") or "none";
	end;
	if Y.value == nil or Y.value == false then
		return "none";
	end;
	return tostring(Y.value);
end;
function on.paint(Y)
	local R, f = Y.n, ff.C;
	local A, k, Q = Y.px, Y.py, Y.pw;
	local j = Y:_enabled();
	zf(Y, jf.R);
	local u = A + jf.gpad;
	Ff(R.label, Y.text, u, k + jf.ty, Rn(Y));
	local P = (u + qf(Y.text)) + M(jf.cw);
	if R.badge then
		Yn(Y, P, k + jf.ty);
		P = (P + qf(Y._badge.text)) + M(jf.cw);
	end;
	local q = ff._drop == Y;
	local g = Of(Y:_display(), o(0, (((A + Q) - jf.gpad) - P) - jf.cw * 2)) .. ((q and " v" or " >"));
	Ff(R.val, g, ((A + Q) - jf.gpad) - qf(g), k + jf.ty, j and f.accent or f.textOff);
end;
function on.press(Y)
	if ff._drop == Y then
		df();
	else
		Cf(Y);
	end;
end;
function on.rpress(Y)
	if Y.multi or #Y.values == 0 then
		return;
	end;
	local R = 0;
	for f = 1, #Y.values, 1 do
		if Y.values[f] == Y.value then
			R = f;
		end;
	end;
	Y:Set(Y.values[R % #Y.values + 1]);
end;
function on._pick(R, Y)
	if R.multi then
		local f = {};
		for Y in pairs(R.value) do
			f[Y] = true;
		end;
		f[Y] = (not f[Y]) or nil;
		R:Set(f);
	elseif R.value == Y and R.allowNone then
		R:Set(false);
	else
		R:Set(Y);
	end;
end;
function on.SetValues(R, Y)
	R.values = {};
	for f = 1, #((Y or {})), 1 do
		R.values[f] = tostring(Y[f]);
	end;
	if R.multi then
		local Y = {};
		for f in pairs(R.value) do
			if R:_has(f) then
				Y[f] = true;
			end;
		end;
		R.value = Y;
	elseif R.value and not R:_has(R.value) then
		R.value = R.allowNone and false or R.values[1];
	end;
	if R.placed then
		R:paint();
	end;
	if ff._drop == R then
		yf();
	end;
	return R;
end;
function on.GetValues(Y)
	return Y.values;
end;
local Qn = Gf();
function Qn.height(Y)
	return jf.R + 4;
end;
function Qn.paint(Y)
	local R, f = Y.n, ff.C;
	local A, k, o = Y.px, Y.py, Y.pw;
	local Q = Y:_enabled();
	local j = ff._hover == Y and Q;
	local u, P, q, g = A + 4, k + 2, o - 8, jf.R;
	af(R.edge, u, P, q, g, j and f.text or f.outlineHi);
	af(R.inner, u + 1, P + 1, q - 2, g - 2, ((Y.held and j)) and f.press or (j and f.controlHi or f.control));
	local O = Y.text;
	local N = Rn(Y);
	if Y._armed then
		O, N = "are you sure?", f.accent;
	end;
	local E = qf(O);
	local T = ((R.badge and not Y._armed)) and Y._badge.text or nil;
	if T then
		E = (E + M(jf.cw)) + qf(T);
	end;
	local S = u + M(((q - E)) / 2);
	local r = P + M(((g - jf.th)) / 2);
	Ff(R.label, O, S, r, N);
	if T then
		Yn(Y, (S + qf(O)) + M(jf.cw), r);
	elseif R.badge then
		Xf(R.badge);
	end;
end;
function Qn.press(Y)
	Y.held = true;
	ff._cap = { kind = "button", wid = Y };
	Y:paint();
end;
function Qn._click(Y)
	if Y.confirm and not Y._armed then
		Y._armed = T() + 2.5;
		ff._armed = Y;
		if Y.placed then
			Y:paint();
		end;
		return;
	end;
	if Y._armed then
		Y._armed = nil;
		if ff._armed == Y then
			ff._armed = nil;
		end;
		if Y.placed then
			Y:paint();
		end;
	end;
	Mf(Y.text, Y.callback, Y);
	for R = 1, #Y.listeners, 1 do
		Mf(Y.text, Y.listeners[R], Y);
	end;
end;
function Qn.Fire(Y)
	Mf(Y.text, Y.callback, Y);
end;
local jn = Gf();
function jn._coerce(R, Y)
	if Y == nil then
		return nil;
	end;
	Y = tostring(Y);
	if R.numeric then
		Y = Y:gsub("[^%d%.%-]", "");
	end;
	if R.maxLength and #Y > R.maxLength then
		Y = P(Y, 1, R.maxLength);
	end;
	return Y;
end;
function jn._cbValue(Y)
	if Y.numeric then
		return tonumber(Y.value);
	end;
	return Y.value;
end;
function jn.height(Y)
	return (((Y.text ~= "" and jf.R or 0)) + jf.R) + 4;
end;
function jn.paint(Y)
	local R, f = Y.n, ff.C;
	local A, k, o = Y.px, Y.py, Y.pw;
	local Q = Y:_enabled();
	local j = k + 2;
	if Y.text ~= "" then
		Ff(R.label, Y.text, A + jf.gpad, k + jf.ty, Rn(Y));
		Yn(Y, ((A + jf.gpad) + qf(Y.text)) + M(jf.cw), k + jf.ty);
		j = k + jf.R;
	else
		Xf(R.label);
	end;
	local u = ff._focus;
	local q = u and u.target == Y;
	local g, O, N = A + 4, o - 8, jf.R;
	af(R.edge, g, j, O, N, q and f.accent or (((ff._hover == Y and Q)) and f.outlineHi or f.outline));
	af(R.inner, g + 1, j + 1, O - 2, N - 2, f.control);
	local E = O - 10;
	local T = j + M(((N - jf.th)) / 2);
	if q then
		local A, k = u.buf, u.caret;
		local o = 0;
		while o < k and Pf(P(A, o + 1, k)) > E do
			o = o + 1;
		end;
		local Q = P(A, o + 1);
		Ff(R.value, P(Q, 1, gf(Q, E)), g + 5, T, f.text);
		Y._first = o;
		if u.caretOn then
			af(R.caret, (g + 5) + M(Pf(P(A, o + 1, k)) + .5), T, 1, jf.th, f.text);
		else
			Xf(R.caret);
		end;
	else
		Xf(R.caret);
		if Y.value == "" then
			Ff(R.value, Of(Y.placeholder, O - 10), g + 5, T, f.textOff);
		else
			Ff(R.value, Of(Y.value, O - 10), g + 5, T, Q and f.text or f.textOff);
		end;
	end;
	Y.boxY, Y.boxH = j, N;
end;
function jn.press(R, Y)
	local f = #R.value;
	if R.boxY then
		f = Nf(R.value, Y - ((R.px + 9)));
	end;
	Kf({
		target = R,
		buf = R.value,
		caret = Q(#R.value, f),
		numeric = R.numeric,
		maxLength = R.maxLength,
		live = R.live,
		commit = function(Y)
			R:Set(Y);
		end,
		preview = function(Y)
			R:Set(Y);
		end,
		refresh = function()
			if R.placed then
				R:paint();
			end;
		end,
	});
end;
local un = Gf();
function un._equal(Y)
	return false;
end;
function un._setRGB(f, Y, R)
	local A, k, M = r(Y[1]), r(Y[2]), r(Y[3]);
	local o = f.rgb;
	if o and (r(o[1]) == A and (r(o[2]) == k and r(o[3]) == M)) then
		return;
	end;
	f.rgb = { A, k, M };
	local Q, j, u = t(f.rgb);
	if (j > 0 and u > 0) or f.h == nil then
		f.h = Q;
	end;
	f.s, f.v = j, u;
	f:_apply(a(f.rgb));
	if ff._pick == f then
		mf();
	end;
	if not R then
		f:_fire();
	end;
end;
function un._setHSV(k, Y, R, f, A)
	k.h, k.s, k.v = Y % 1, U(R, 0, 1), U(f, 0, 1);
	k.rgb = F(k.h, k.s, k.v);
	k:_apply(a(k.rgb));
	if ff._pick == k then
		mf();
	end;
	if not A then
		k:_fire();
	end;
end;
function un.Set(f, Y, R)
	local A = H(Y);
	if A then
		f:_setRGB(A, R);
	end;
	return f;
end;
function un.GetRGB(Y)
	return r(Y.rgb[1]), r(Y.rgb[2]), r(Y.rgb[3]);
end;
function un.GetHex(Y)
	return D(Y.rgb);
end;
function un.SetRainbow(R, Y)
	Y = Y and true or false;
	R.rainbow = Y;
	ff._rainbow[R] = Y or nil;
	if ff._pick == R then
		mf();
	end;
	R.win:_changed(R);
	return R;
end;
function un._paintSwatch(f, Y, R)
	local A, k = f.n, ff.C;
	local M, o = jf.cb * 2 + 4, jf.cb;
	local Q = (ff._pick == f) or (ff._hover == ((f.host or f)) and f:_enabled());
	af(A.swEdge, Y, R, M, o, Q and k.text or k.outlineHi);
	af(A.swRing, Y + 1, R + 1, M - 2, o - 2, k.control);
	af(A.swFill, Y + 2, R + 2, M - 4, o - 4, f.value);
	return M;
end;
function un.paint(Y)
	local R = Y.n;
	local f, A, k = Y.px, Y.py, Y.pw;
	zf(Y, jf.R);
	local o = f + jf.gpad;
	Ff(R.label, Y.text, o, A + jf.ty, Rn(Y));
	Yn(Y, (o + qf(Y.text)) + M(jf.cw), A + jf.ty);
	local Q = jf.cb * 2 + 4;
	local j = ((f + k) - jf.gpad) - Q;
	Y:_paintSwatch(j, A + M(((jf.R - jf.cb)) / 2));
	Y.zx1, Y.zx2 = j, j + Q;
	fn(Y, j - 6, A);
end;
function un.paintInline(f, Y, R)
	local A = f.host;
	f.px, f.py, f.pw = A.px, A.py, A.pw;
	f.placed = true;
	local k = jf.cb * 2 + 4;
	local o = Y - k;
	f:_paintSwatch(o, R + M(((jf.R - jf.cb)) / 2));
	f.zx1, f.zx2 = o, Y;
	return o;
end;
function un.press(R, Y)
	if not R.inline then
		local f = An(R, Y);
		if f and f ~= R then
			if f:_enabled() then
				f:press(Y);
			end;
			return;
		end;
	end;
	if ff._pick == R then
		wf();
	else
		Zf(R);
	end;
end;
function un._cbValue(Y)
	return Y.value;
end;
local Pn = Gf();
local qn = { "toggle", "hold", "always" };
function Pn._coerce(R, Y)
	if Y == nil or Y == false or Y == "" or Y == "NONE" or Y == "none" then
		return false;
	end;
	return m(Y);
end;
function Pn._equal(R, Y)
	return ((Y or false)) == ((R.vk or false));
end;
function Pn._apply(R, Y)
	R.vk = Y or nil;
	R.value = R.vk and d[R.vk] or nil;
	R.down = R.vk and J(R.vk) or false;
	R:_repaint();
	R.win:_changed(R);
end;
function Pn.Set(R, Y)
	local f = R:_coerce(Y);
	if f == nil or R:_equal(f) then
		return R;
	end;
	R:_apply(f);
	if R.o.changed then
		Mf("keybind", R.o.changed, R.value, R);
	end;
	return R;
end;
function Pn.Get(Y)
	return Y.value;
end;
function Pn.GetKey(Y)
	return Y.vk;
end;
function Pn.GetState(Y)
	if Y.mode == "always" then
		return true;
	end;
	if Y.host and Y.sync then
		return Y.host.value;
	end;
	return Y.state;
end;
function Pn.SetMode(R, Y)
	for f, A in ipairs(qn) do
		if A == Y then
			R.mode = Y;
			R.state = (Y == "always");
			R.win:_changed(R);
		end;
	end;
	return R;
end;
function Pn.OnClick(R, Y)
	R.clicks[#R.clicks + 1] = Y;
	return R;
end;
function Pn._tag(Y)
	if ff._listen == Y then
		return "[...]";
	end;
	if Y._flash and T() < Y._flash then
		return "[" .. (Y.mode .. "]");
	end;
	return "[" .. (((Y.value or "-")) .. "]");
end;
function Pn._cbValue(Y)
	return Y:GetState();
end;
function Pn.paint(Y)
	local R, f = Y.n, ff.C;
	local A, k, o = Y.px, Y.py, Y.pw;
	local Q = Y:_enabled();
	zf(Y, jf.R);
	local j = A + jf.gpad;
	Ff(R.label, Y.text, j, k + jf.ty, Rn(Y));
	Yn(Y, (j + qf(Y.text)) + M(jf.cw), k + jf.ty);
	local u = Y:_tag();
	local P = ((A + o) - jf.gpad) - qf(u);
	Ff(R.key, u, P, k + jf.ty, (ff._listen == Y) and f.text or (Q and f.accent or f.textOff));
	Y.zx1, Y.zx2 = P, (A + o) - jf.gpad;
end;
function Pn.paintInline(f, Y, R)
	local A, k = f.host, ff.C;
	f.px, f.py, f.pw = A.px, A.py, A.pw;
	f.placed = true;
	local M = f:_tag();
	local o = Y - qf(M);
	Ff(f.n.key, M, o, R + jf.ty, (ff._listen == f) and k.text or (f:_enabled() and k.accent or k.textOff));
	f.zx1, f.zx2 = o, Y;
	return o;
end;
function Pn.press(Y)
	if ff._listen == Y then
		If(Y, nil, true);
	else
		Bf(Y);
	end;
end;
function Pn.rpress(Y)
	local R = 1;
	for f, A in ipairs(qn) do
		if A == Y.mode then
			R = f;
		end;
	end;
	Y:SetMode(qn[R % #qn + 1]);
	Y._flash = T() + .9;
	ff._flashW = Y;
	Y:_repaint();
end;
function Pn._setState(R, Y)
	if Y == R.state then
		return;
	end;
	R.state = Y;
	if bf.visible then
		bf.dirty = true;
	end;
	Mf(R.text ~= "" and R.text or "keybind", R.callback, Y, R);
	for f = 1, #R.listeners, 1 do
		Mf("keybind", R.listeners[f], Y, R);
	end;
end;
function Pn._edge(R, Y)
	local f = R.host;
	if R.mode == "hold" then
		if f and R.sync then
			f:Set(Y);
		else
			R:_setState(Y);
		end;
	elseif R.mode == "toggle" and Y then
		if f and R.sync then
			f:Set(not f.value);
			R:_toast(f.value);
		elseif R.callback or #R.listeners > 0 or #R.clicks == 0 then
			R:_setState(not R.state);
			R:_toast(R.state);
		else
			R:_toast(nil);
		end;
	end;
	if Y then
		for Y = 1, #R.clicks, 1 do
			Mf("keybind", R.clicks[Y], R);
		end;
	end;
end;
function Pn._toast(R, Y)
	if not ff.Settings.bindToasts or R.o.notify == false then
		return;
	end;
	local f = (R.text ~= "" and R.text) or (R.host and R.host.text) or "keybind";
	ff.Notify({
		text = Y == nil and f or (f .. (": " .. ((Y and "on" or "off")))),
		duration = 1.6,
		color = Y == false and ff.C.textDim or nil,
		key = R,
	});
end;
local gn = Gf();
function gn._split(Y)
	local R;
	local f = Y.pw and (Y.pw - jf.gpad * 2) or 0;
	if Y.wrap and f > jf.cw * 4 then
		R = Ef(Y.text, f);
	else
		R = {};
		for Y in ((Y.text .. "\n")):gmatch("(.-)\n") do
			R[#R + 1] = Y;
		end;
	end;
	Y.lines = R;
	Y._splitW, Y._splitCw = Y.pw, jf.cw;
	for R = #Y.n.lines + 1, #R, 1 do
		Y.n.lines[R] = nf(Y, "Text", rf.text);
	end;
end;
function gn.height(Y)
	if Y.wrap and ((Y._splitW ~= Y.pw or Y._splitCw ~= jf.cw)) then
		Y:_split();
	end;
	return jf.R * o(1, #Y.lines);
end;
function gn.paint(Y)
	local R = ff.C;
	local f = Y.color or (Y.dim and R.textDim or R.text);
	if not Y:_enabled() then
		f = R.textOff;
	end;
	local A = Y.pw - jf.gpad * 2;
	for R, k in ipairs(Y.n.lines) do
		if R <= #Y.lines then
			Ff(k, Of(Y.lines[R], A), Y.px + jf.gpad, (Y.py + ((R - 1)) * jf.R) + jf.ty, f);
		else
			Xf(k);
		end;
	end;
	fn(Y, (Y.px + Y.pw) - jf.gpad, Y.py);
end;
function gn.SetText(R, Y)
	R.text = tostring(Y or "");
	local f = #R.lines;
	R:_split();
	if #R.lines ~= f then
		R.win._dirty = true;
	elseif R.placed then
		R:paint();
	end;
	return R;
end;
function gn.SetColor(R, Y)
	R.color = Y;
	if R.placed then
		R:paint();
	end;
	return R;
end;
function gn.press(R, Y)
	local f = An(R, Y);
	if f and f:_enabled() then
		f:press(Y);
	end;
end;
function gn.rpress(R, Y)
	local f = An(R, Y);
	if f and f.rpress then
		f:rpress(Y);
	end;
end;
local On = Gf();
function On.height(Y)
	return 9;
end;
function On.paint(Y)
	af(Y.n.line, Y.px + jf.gpad, Y.py + 4, Y.pw - jf.gpad * 2, 1, ff.C.border);
end;
local Nn = {};
Nn.__index = Nn;
local function En(Y, R)
	R = type(R) == "table" and R or { default = R };
	local f = Vf(Y.group, "keybind", R, Pn, Y);
	f.n = { key = nf(f, "Text", rf.text) };
	f.mode = R.mode or "toggle";
	f.state = f.mode == "always";
	f.sync = (Y.kind == "toggle") and (R.sync ~= false);
	f.clicks = {};
	if R.onClick then
		f.clicks[1] = R.onClick;
	end;
	f:_apply(m(R.default or R.key) or false);
	ff._binds[#ff._binds + 1] = f;
	return f;
end;
local function Tn(Y, R)
	R = type(R) == "table" and R or { default = R };
	local f = Vf(Y.group, "color", R, un, Y);
	f.n = { swEdge = nf(f, "Square", rf.ctl), swRing = nf(f, "Square", rf.ctlIn), swFill = nf(f, "Square", rf.ctlFill) };
	f.title = R.title or (Y.text ~= "" and Y.text or "color");
	f.h = 0;
	f:_setRGB(H(R.default) or { 255, 255, 255 }, true);
	if R.rainbow then
		f:SetRainbow(true);
	end;
	return f;
end;
kn.AddKeybind = En;
kn.AddColor = Tn;
kn.AddColorPicker = Tn;
gn.AddKeybind = En;
gn.AddColor = Tn;
gn.AddColorPicker = Tn;
function Nn.AddToggle(R, Y)
	local f = Vf(R, "toggle", Y, kn);
	Y = f.o;
	f.value = ((Y.default or Y.Default)) and true or false;
	f.n = {
			hover = nf(f, "Square", rf.hover),
			label = nf(f, "Text", rf.text),
			box = nf(f, "Square", rf.ctl),
			boxIn = nf(f, "Square", rf.ctlIn),
			fill = nf(f, "Square", rf.ctlFill),
		};
	if f._badge then
		f.n.badge = nf(f, "Text", rf.text);
	end;
	f.addons = {};
	return f;
end;
Nn.AddCheckbox = Nn.AddToggle;
function Nn.AddSlider(R, Y)
	local f = Vf(R, "slider", Y, Mn);
	Y = f.o;
	f.min = tonumber(Y.min or Y.Min) or 0;
	f.max = tonumber(Y.max or Y.Max) or 100;
	if f.max < f.min then
		f.min, f.max = f.max, f.min;
	end;
	local A = tonumber(Y.decimals or Y.rounding);
	f.step = tonumber(Y.step or Y.increment) or (A and 10 ^ (-M(A))) or 1;
	if not A then
		A = 0;
		if f.step > 0 and f.step < 1 then
			local Y = (u("%.6f", f.step)):gsub("0+$", "");
			A = #((Y:match("%.(%d*)$") or ""));
		end;
	end;
	f.decimals = U(M(A), 0, 6);
	f.suffix = tostring(Y.suffix or "");
	f.format = Y.format;
	f.value = f:_coerce(Y.default or Y.Default or f.min) or f.min;
	f.n = {
			hover = nf(f, "Square", rf.hover),
			label = nf(f, "Text", rf.text),
			val = nf(f, "Text", rf.text),
			edge = nf(f, "Square", rf.ctl),
			inner = nf(f, "Square", rf.ctlIn),
			fill = nf(f, "Square", rf.ctlFill),
			caret = nf(f, "Square", rf.ctlFill),
		};
	if f._badge then
		f.n.badge = nf(f, "Text", rf.text);
	end;
	return f;
end;
function Nn.AddDropdown(R, Y)
	local f = Vf(R, "dropdown", Y, on);
	Y = f.o;
	f.multi = Y.multi and true or false;
	f.allowNone = Y.allowNone or Y.AllowNull;
	f.values = {};
	for Y, R in ipairs(Y.values or Y.Values or Y.options or {}) do
		f.values[Y] = tostring(R);
	end;
	if f.multi then
		f.value = {};
		f.value = f:_coerce(Y.default or Y.Default or {});
	else
		local R = Y.default or Y.Default;
		if type(R) == "number" and f.values[R] then
			R = f.values[R];
		end;
		f.value = f:_coerce(R);
		if f.value == nil then
			f.value = f.allowNone and false or f.values[1];
		end;
	end;
	f.n = { hover = nf(f, "Square", rf.hover), label = nf(f, "Text", rf.text), val = nf(f, "Text", rf.text) };
	if f._badge then
		f.n.badge = nf(f, "Text", rf.text);
	end;
	return f;
end;
function Nn.AddButton(f, Y, R)
	if type(Y) == "string" then
		Y = { text = Y, callback = R };
	end;
	local A = Vf(f, "button", Y, Qn);
	A.confirm = Y.confirm or Y.DoubleClick;
	A.n = { edge = nf(A, "Square", rf.ctl), inner = nf(A, "Square", rf.ctlIn), label = nf(A, "Text", rf.text) };
	if A._badge then
		A.n.badge = nf(A, "Text", rf.text);
	end;
	return A;
end;
