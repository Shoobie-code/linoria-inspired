	f.numeric = Y.numeric;
	f.maxLength = tonumber(Y.maxLength or Y.MaxLength);
	f.placeholder = tostring(Y.placeholder or Y.Placeholder or "");
	f.live = Y.live;
	f.value = f:_coerce(Y.default or Y.Default or "") or "";
	f.n = {
			label = nf(f, "Text", rf.text),
			edge = nf(f, "Square", rf.ctl),
			inner = nf(f, "Square", rf.ctlIn),
			value = nf(f, "Text", rf.text),
			caret = nf(f, "Square", rf.ctlFill),
		};
	if f._badge then
		f.n.badge = nf(f, "Text", rf.text);
	end;
	return f;
end;
Nn.AddInput = Nn.AddTextbox;
