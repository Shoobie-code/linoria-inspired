local function r(Y)
	return M(Y + .5);
end;
local function U(Y, R, f)
	if Y ~= Y then
		return R;
	end;
	if Y < R then
		return R;
	end;
	if Y > f then
		return f;
	end;
	return Y;
end;
local function c(Y, R, f, A, k, M)
	return Y >= f and (R >= A and (Y < f + k and R < A + M));
end;
local function X(Y, R, f)
	return { Y[1] + ((R[1] - Y[1])) * f, Y[2] + ((R[2] - Y[2])) * f, Y[3] + ((R[3] - Y[3])) * f };
end;
local function a(Y)
	return k(U(r(Y[1]), 0, 255), U(r(Y[2]), 0, 255), U(r(Y[3]), 0, 255));
end;
local function F(Y, R, f)
	Y = ((Y % 1)) * 6;
	local A = M(Y);
	local k = Y - A;
	local o, Q, j = f * ((1 - R)), f * ((1 - R * k)), f * ((1 - R * ((1 - k))));
	local u, P, q;
	if A == 0 then
		u, P, q = f, j, o;
	elseif A == 1 then
		u, P, q = Q, f, o;
	elseif A == 2 then
		u, P, q = o, f, j;
	elseif A == 3 then
		u, P, q = o, Q, f;
	elseif A == 4 then
		u, P, q = j, o, f;
	else
		u, P, q = f, o, Q;
	end;
	return { u * 255, P * 255, q * 255 };
end;
local function t(Y)
	local R, f, A = Y[1] / 255, Y[2] / 255, Y[3] / 255;
	local k, M = o(R, f, A), Q(R, f, A);
	local j = k - M;
	local u = 0;
	if j > 0 then
		if k == R then
			u = ((((f - A)) / j)) % 6;
		elseif k == f then
			u = ((A - R)) / j + 2;
		else
			u = ((R - f)) / j + 4;
		end;
		u = u / 6;
	end;
	return u, (k > 0) and (j / k) or 0, k;
end;
local function D(Y)
	return u("#%02X%02X%02X", U(r(Y[1]), 0, 255), U(r(Y[2]), 0, 255), U(r(Y[3]), 0, 255));
end;
local function W(Y)
	Y = (((tostring(Y or "")):gsub("^%s*#?", "")):gsub("%s+$", ""));
	if #Y == 3 then
		Y = (P(Y, 1, 1)):rep(2) .. ((P(Y, 2, 2)):rep(2) .. (P(Y, 3, 3)):rep(2));
	end;
	if #Y ~= 6 or Y:find("[^%x]") then
		return nil;
	end;
	return { tonumber(P(Y, 1, 2), 16), tonumber(P(Y, 3, 4), 16), tonumber(P(Y, 5, 6), 16) };
end;
local function H(Y)
	if type(Y) == "string" then
		return W(Y);
	end;
	if type(Y) == "table" then
		if type(Y[1]) == "number" then
			return { U(Y[1], 0, 255), U(tonumber(Y[2]) or 0, 0, 255), U(tonumber(Y[3]) or 0, 0, 255) };
		end;
		if type(Y.r) == "number" then
			return { U(Y.r, 0, 255), U(tonumber(Y.g) or 0, 0, 255), U(tonumber(Y.b) or 0, 0, 255) };
		end;
		if type(Y.hex) == "string" then
			return W(Y.hex);
		end;
	end;
	if Y ~= nil then
		local R, f, A, k = pcall(function()
				return Y.R, Y.G, Y.B;
			end);
		if R and (type(f) == "number" and (type(A) == "number" and type(k) == "number")) then
			return { f * 255, A * 255, k * 255 };
		end;
	end;
	return nil;
end;
local x;
local function C(Y)
	if not x then
		x = {};
		for Y = 0, 359, 1 do
			x[Y] = a(F(Y / 360, .62, 1));
		end;
	end;
	return x[M(Y) % 360];
end;
